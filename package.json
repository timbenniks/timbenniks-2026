{
  "name": "timbenniks-2026",
  "type": "module",
  "version": "0.0.1",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "predev": "npm run build:admin",
    "dev": "astro dev",
    "dev:admin": "node scripts/build-admin.mjs --watch",
    "prebuild": "npm run build:admin",
    "build": "astro build && pagefind --site dist/client && rm -rf .vercel/output/static/pagefind && cp -R dist/client/pagefind .vercel/output/static/pagefind",
    "build:admin": "node scripts/build-admin.mjs",
    "preview": "astro preview",
    "check": "astro check",
    "astro": "astro",
    "vendor:comark": "node scripts/vendor-comark.mjs",
    "pretest:e2e": "npm run build:admin",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:install": "playwright install chromium",
    "agentlint": "agentlint scan --agent --missions",
    "agentlint:local": "agentlint scan http://127.0.0.1:4321 --allow-private --agent --missions"
  },
  "dependencies": {
    "@astrojs/markdown-remark": "7.2.2",
    "@astrojs/rss": "^4.0.19",
    "@astrojs/sitemap": "^3.7.3",
    "@astrojs/vercel": "^11.0.5",
    "@comark/html": "^0.6.2",
    "@mcp-b/global": "^4.0.0",
    "@tailwindcss/vite": "^4.3.3",
    "@vercel/functions": "^3.8.0",
    "astro": "^7.2.0",
    "dompurify": "^3.4.13",
    "lite-youtube-embed": "^0.3.4",
    "tailwindcss": "^4.3.3"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@playwright/test": "^1.62.1",
    "@timbenniks/agentlint": "^0.1.0-rc.1",
    "esbuild": "^0.28.1",
    "pagefind": "^1.5.2",
    "typescript": "^5.9.3"
  },
  "allowScripts": {
    "esbuild@0.28.1": true
  }
}
