---
import Card from './Card.astro';
import type { CardItem } from '../lib/card';

interface Props {
  title: string;
  items: CardItem[];
  id?: string;
}

const { title, items, id = 'related-cards-heading' } = Astro.props;
---

{
  items.length > 0 && (
    <section class="mt-16 border-t border-line pt-12" aria-labelledby={id}>
      <h2 id={id} class="font-serif text-3xl font-medium text-ink md:text-4xl">
        {title}
      </h2>
      <div class="mt-8 grid grid-cols-1 gap-8 sm:grid-cols-2 lg:grid-cols-3">
        {items.map((item, i) => (
          <Card item={item} format="standard" eager={i === 0} />
        ))}
      </div>
    </section>
  )
}
