---
import { seo } from '../../data/site';
import { pageCanonical } from '../../lib/canonical';

interface Props {
  title: string;
  description: string;
  image?: string;
  imageAlt?: string;
  type?: 'website' | 'article';
  publishedTime?: Date | string;
  modifiedTime?: Date | string;
  tags?: string[];
  keywords?: string;
  canonical?: string;
  noindex?: boolean;
  markdownHref?: string;
}

const {
  title,
  description,
  image = seo.defaultImage,
  imageAlt = seo.defaultImageAlt,
  type = 'website',
  publishedTime,
  modifiedTime,
  tags = [],
  keywords,
  canonical,
  noindex = false,
  markdownHref,
} = Astro.props;

const canonicalURL = canonical ?? pageCanonical(Astro.url.pathname);
const fullTitle = `${title}${seo.titleSuffix}`;
const isoDate = (d?: Date | string) =>
  d ? (typeof d === 'string' ? new Date(d) : d).toISOString() : undefined;
const published = isoDate(publishedTime);
const modified = isoDate(modifiedTime) ?? published;
---

<title>{fullTitle}</title>
<meta name="description" content={description} />
{keywords && <meta name="keywords" content={keywords} />}
{noindex && <meta name="robots" content="noindex" />}

<link rel="canonical" href={canonicalURL} />
<link rel="sitemap" href="/sitemap-index.xml" />
<link rel="alternate" type="application/rss+xml" title="RSS Feed for Tim Benniks" href="/feed.xml" />
<link rel="alternate" type="application/feed+json" title="JSON Feed for Tim Benniks" href="/feed.json" />
<link rel="alternate" type="text/plain" title="llms.txt" href="/llms.txt" />
<link rel="alternate" type="text/plain" title="Full markdown corpus" href="/llms-full.txt" />
<link rel="alternate" type="application/json" title="Public WebMCP tool catalog" href="/tools.json" />
<link rel="help" type="text/markdown" title="Guide for AI agents" href="/agents.md" />
{markdownHref && (
  <link rel="alternate" type="text/markdown" title="Markdown source" href={markdownHref} />
)}

<meta name="generator" content={Astro.generator} />

<meta property="og:site_name" content={seo.siteName} />
<meta property="og:type" content={type} />
<meta property="og:url" content={canonicalURL} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:image" content={image} />
<meta property="og:image:width" content={String(seo.defaultImageWidth)} />
<meta property="og:image:height" content={String(seo.defaultImageHeight)} />
<meta property="og:image:alt" content={imageAlt} />
<meta property="og:locale" content={seo.locale} />

{type === 'article' && published && (
  <meta property="article:published_time" content={published} />
)}
{type === 'article' && modified && (
  <meta property="article:modified_time" content={modified} />
)}
{type === 'article' && (
  <meta property="article:author" content="Tim Benniks" />
)}
{type === 'article' && tags.map((tag) => (
  <meta property="article:tag" content={tag} />
))}

<meta property="twitter:card" content="summary_large_image" />
<meta property="twitter:creator" content={seo.twitterCreator} />
<meta property="twitter:title" content={title} />
<meta property="twitter:description" content={description} />
<meta property="twitter:image" content={image} />
