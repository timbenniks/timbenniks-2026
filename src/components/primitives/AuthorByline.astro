---
import { author } from '../../data/site';

interface Props {
  label?: string;
  dark?: boolean;
}

const { label = 'Written by', dark = false } = Astro.props;
---

<div>
  <p
    class:list={[
      'font-mono text-xs uppercase tracking-wide',
      dark ? 'text-cream-subtle' : 'text-ink-subtle',
    ]}
  >
    {label}
  </p>
  <a href={author.href} class="mt-3 flex items-center gap-3 no-underline group">
    <img
      src={author.avatar}
      alt=""
      width="48"
      height="48"
      class:list={[
        'h-12 w-12 rounded-full object-cover border',
        dark ? 'border-line-dark' : 'border-line',
      ]}
      loading="lazy"
    />
    <span
      class:list={[
        'font-serif text-lg transition-colors',
        dark
          ? 'text-cream group-hover:text-accent-bright'
          : 'text-ink group-hover:text-accent',
      ]}
    >
      {author.name}
    </span>
  </a>
</div>
