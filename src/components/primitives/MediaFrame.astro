---
type Aspect = 'video' | 'square' | 'portrait' | 'landscape' | 'auto';

interface Props {
  aspect?: Aspect;
  hoverable?: boolean;
  class?: string;
}

const { aspect = 'video', hoverable = false, class: className = '' } = Astro.props;

const aspectClass: Record<Aspect, string> = {
  video: 'aspect-video',
  square: 'aspect-square',
  portrait: 'aspect-[3/4]',
  landscape: 'aspect-[4/3]',
  auto: '',
};
---

<div
  class:list={[
    'overflow-hidden border border-line bg-bg-soft',
    aspectClass[aspect],
    hoverable && 'transition-transform duration-300 group-hover:scale-[1.01]',
    className,
  ]}
>
  <slot />
</div>
