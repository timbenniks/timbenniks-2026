---
import Eyebrow from './Eyebrow.astro';
import { editAttr, editPath } from '../../lib/admin/edit-path';

interface Props {
  editBase?: string;
  eyebrow?: string;
  title: string;
  lede?: string;
  dark?: boolean;
}

const { editBase, eyebrow, title, lede, dark = false } = Astro.props;
---

<div>
  {eyebrow && (
    <Eyebrow dark={dark}>
      <span {...editAttr(editPath(editBase, 'eyebrow'))}>{eyebrow}</span>
    </Eyebrow>
  )}
  <h2
    class:list={[
      'font-serif font-medium text-5xl mb-4',
      dark ? 'text-cream' : 'text-ink',
    ]}
    {...editAttr(editPath(editBase, 'title'))}
  >
    {title}
  </h2>
  {lede && (
    <p
      class:list={['max-w-prose-sm text-base', dark ? 'text-cream-muted' : 'text-ink-muted']}
      {...editAttr(editPath(editBase, 'lede'))}
    >
      {lede}
    </p>
  )}
</div>
