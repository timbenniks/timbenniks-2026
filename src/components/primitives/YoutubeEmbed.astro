---
interface Props {
  videoId: string;
  title: string;
  poster: string;
  class?: string;
}

const { videoId, title, poster, class: className = '' } = Astro.props;
const watchUrl = `https://www.youtube.com/watch?v=${videoId}`;
const playLabel = `Play: ${title}`;
---

<div class:list={['tb-youtube', className]}>
  <lite-youtube
    videoid={videoId}
    playlabel={playLabel}
    title={title}
    style={`background-image: url('${poster}')`}
  >
    <a href={watchUrl} class="lyt-playbtn" title={playLabel}>
      <svg viewBox="0 0 68 48" width="68" height="48" aria-hidden="true">
        <path
          d="M66.52 7.74c-.78-2.93-2.49-5.41-5.42-6.19C55.79.13 34 0 34 0S12.21.13 6.9 1.55c-2.93.78-4.63 3.26-5.42 6.19C.06 13.05 0 24 0 24s.06 10.95 1.48 16.26c.78 2.93 2.49 5.41 5.42 6.19C12.21 47.87 34 48 34 48s21.79-.13 27.1-1.55c2.93-.78 4.64-3.26 5.42-6.19C67.94 34.95 68 24 68 24s-.06-10.95-1.48-16.26z"
          fill="red"></path>
        <path d="M45 24 27 14v20" fill="white"></path>
      </svg>
      <span class="lyt-visually-hidden">{playLabel}</span>
    </a>
  </lite-youtube>
</div>

<style is:global>
  /*
    Own the embed layout. Do not import lite-youtube-embed.css:
    it caps width at 720px and only sizes a direct-child iframe.
    Safari/mobile use the YT IFrame API, which wraps the iframe in a div
    with inline 560×315 / 390px sizes.
  */
  .tb-youtube {
    position: relative;
    width: 100%;
    aspect-ratio: 16 / 9;
    overflow: hidden;
    border: 1px solid var(--color-line);
    background: #000;
  }

  .tb-youtube lite-youtube {
    display: block;
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    max-width: none;
    background-color: #000;
    background-position: center;
    background-size: cover;
    cursor: pointer;
  }

  .tb-youtube lite-youtube iframe,
  .tb-youtube lite-youtube > div {
    position: absolute !important;
    inset: 0 !important;
    width: 100% !important;
    height: 100% !important;
    max-width: none !important;
    border: 0;
  }

  .tb-youtube .lyt-playbtn {
    position: absolute;
    inset: 0;
    z-index: 1;
    display: flex;
    align-items: center;
    justify-content: center;
    margin: 0;
    padding: 0;
    border: 0;
    background: none;
    cursor: pointer;
    text-decoration: none;
  }

  .tb-youtube .lyt-playbtn svg {
    width: 68px;
    height: 48px;
    filter: grayscale(100%);
    transition: filter 0.1s cubic-bezier(0, 0, 0.2, 1);
  }

  .tb-youtube lite-youtube:hover .lyt-playbtn svg,
  .tb-youtube .lyt-playbtn:focus svg,
  .tb-youtube .lyt-playbtn:focus-visible svg {
    filter: none;
  }

  .tb-youtube lite-youtube.lyt-activated {
    cursor: unset;
  }

  .tb-youtube lite-youtube.lyt-activated .lyt-playbtn {
    opacity: 0;
    pointer-events: none;
  }

  .tb-youtube .lyt-visually-hidden {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    overflow: hidden;
    clip: rect(0 0 0 0);
    clip-path: inset(50%);
    white-space: nowrap;
    border: 0;
  }
</style>

<script>
  import 'lite-youtube-embed';
</script>
