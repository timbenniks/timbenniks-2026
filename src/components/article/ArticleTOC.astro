---
import type { MarkdownHeading } from 'astro';

interface Props {
  headings: MarkdownHeading[];
  /** Set false to hide the “On this page” label (e.g. inside a details summary). */
  showLabel?: boolean;
}

const { headings, showLabel = true } = Astro.props;
const items = headings.filter((h) => h.depth === 2 || h.depth === 3);
---

{
  items.length > 0 && (
    <nav aria-label="On this page" data-article-toc>
      {showLabel && (
        <p class="font-mono text-xs uppercase tracking-wide text-ink-subtle">On this page</p>
      )}
      <ul class:list={['flex flex-col gap-2.5 border-l border-line', showLabel && 'mt-3']}>
        {items.map((h) => (
          <li>
            <a
              href={`#${h.slug}`}
              data-toc-link
              data-depth={h.depth}
              class:list={[
                'block border-l-2 border-transparent -ml-px py-0.5 text-sm text-ink-muted no-underline transition-colors hover:text-ink',
                h.depth === 3 && 'pl-5',
                h.depth === 2 && 'pl-3',
              ]}
            >
              {h.text}
            </a>
          </li>
        ))}
      </ul>
    </nav>
  )
}

<script>
  function initArticleToc() {
    const navs = document.querySelectorAll<HTMLElement>('[data-article-toc]');
    if (navs.length === 0) return;

    const allLinks = [...document.querySelectorAll<HTMLAnchorElement>('[data-article-toc] [data-toc-link]')];
    if (allLinks.length === 0) return;

    const idToLinks = new Map<string, HTMLAnchorElement[]>();
    const targets: HTMLElement[] = [];

    for (const link of allLinks) {
      const id = decodeURIComponent(link.hash.slice(1));
      const el = document.getElementById(id);
      if (!el) continue;
      const list = idToLinks.get(id) ?? [];
      list.push(link);
      idToLinks.set(id, list);
      if (!targets.includes(el)) targets.push(el);
    }

    if (targets.length === 0) return;

    const activeClasses = ['border-accent', 'text-ink'];
    const inactiveClasses = ['border-transparent', 'text-ink-muted'];

    let activeId = '';
    const setActive = (id: string) => {
      if (id === activeId) return;
      activeId = id;
      for (const [headingId, links] of idToLinks) {
        const on = headingId === id;
        for (const link of links) {
          link.classList.toggle(activeClasses[0], on);
          link.classList.toggle(activeClasses[1], on);
          link.classList.toggle(inactiveClasses[0], !on);
          link.classList.toggle(inactiveClasses[1], !on);
        }
      }
    };

    const observer = new IntersectionObserver(
      (entries) => {
        const visible = entries
          .filter((e) => e.isIntersecting)
          .sort((a, b) => a.boundingClientRect.top - b.boundingClientRect.top);
        if (visible[0]?.target instanceof HTMLElement) {
          setActive(visible[0].target.id);
        }
      },
      { rootMargin: '-20% 0px -70% 0px', threshold: 0 },
    );

    for (const el of targets) observer.observe(el);

    const hashId = decodeURIComponent(location.hash.slice(1));
    if (hashId && idToLinks.has(hashId)) {
      setActive(hashId);
    } else if (targets[0]) {
      setActive(targets[0].id);
    }
  }

  initArticleToc();
  document.addEventListener('astro:page-load', initArticleToc);
</script>
