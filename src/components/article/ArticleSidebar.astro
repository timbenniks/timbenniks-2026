---
import MediaFrame from '../primitives/MediaFrame.astro';
import AuthorByline from '../primitives/AuthorByline.astro';
import ArticleTOC from './ArticleTOC.astro';
import type { MarkdownHeading } from 'astro';

interface Props {
  title: string;
  image?: string;
  readingLabel?: string;
  headings: MarkdownHeading[];
}

const { title, image, readingLabel, headings } = Astro.props;
const tocHeadings = headings.filter((h) => h.depth === 2 || h.depth === 3);
---

<aside class="lg:w-80 lg:flex-shrink-0 xl:w-96">
  <div class="flex flex-col gap-8 lg:sticky lg:top-24 lg:self-start">
    <AuthorByline />

    {
      image && (
        <MediaFrame aspect="video" class="hidden lg:block">
          <img
            src={image}
            alt={title}
            width="768"
            height="432"
            class="h-full w-full object-cover"
            loading="eager"
            fetchpriority="high"
          />
        </MediaFrame>
      )
    }

    {
      readingLabel && (
        <p class="font-mono text-xs uppercase tracking-wide text-accent">{readingLabel}</p>
      )
    }

    {
      tocHeadings.length > 0 && (
        <div class="hidden lg:block">
          <ArticleTOC headings={headings} />
        </div>
      )
    }
  </div>
</aside>
