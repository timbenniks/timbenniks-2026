---
import Card from '../Card.astro';
import type { CardItem } from '../../lib/card';

interface Props {
  items: CardItem[];
}

const { items } = Astro.props;
---

{
  items.length > 0 && (
    <section class="mt-16 border-t border-line pt-12" aria-labelledby="related-articles-heading">
      <h2
        id="related-articles-heading"
        class="font-serif text-3xl font-medium text-ink md:text-4xl"
      >
        Related articles
      </h2>
      <div class="mt-8 grid grid-cols-1 gap-8 sm:grid-cols-2 lg:grid-cols-3">
        {items.map((item, i) => (
          <Card item={item} format="standard" eager={i === 0} />
        ))}
      </div>
    </section>
  )
}
