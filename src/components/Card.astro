---
import { Image } from "astro:assets";
import Button from "./primitives/Button.astro";
import MediaFrame from "./primitives/MediaFrame.astro";
import Meta from "./primitives/Meta.astro";
import type { CardItem, CardKind } from "../lib/card";
import { cardFeatureWidths, cardStandardWidths } from "../lib/image-widths";

export type CardFormat = "feature" | "standard" | "row";

interface Props {
  item: CardItem;
  format: CardFormat;
  isLast?: boolean;
  eager?: boolean;
}

const { item, format, isLast = false, eager = false } = Astro.props;

const imgLoading = eager ? "eager" : "lazy";
const imgFetchPriority = eager ? "high" : "auto";
const imgDecoding = eager ? "sync" : "async";

const linkAttrs = item.href
  ? {
      href: item.href,
      ...(item.external
        ? { target: "_blank", rel: "noopener noreferrer" }
        : {}),
    }
  : null;

const defaultCta: Record<CardKind, string> = {
  article: "Read the article",
  video: "Watch the video",
  talk: "View talk",
  project: "Learn more",
};
const ctaLabel = item.ctaLabel ?? defaultCta[item.kind];

const bylineParts = [item.date, ...(item.meta ?? [])].filter(
  Boolean,
) as string[];

const featureWidths = cardFeatureWidths;
const featureSizes = "(min-width: 1024px) 720px, 100vw";

const standardWidths = cardStandardWidths;
const standardSizes =
  "(min-width: 1024px) 33vw, (min-width: 768px) 50vw, 100vw";

const playIcon = `<svg viewBox="0 0 12 12" class="ml-0.5 h-3.5 w-3.5 fill-bg-dark"><path d="M2 1l9 5-9 5z" /></svg>`;
---

{
  format === "feature" && (
    <article class="group flex flex-col gap-3">
      {item.image && (
        <MediaFrame aspect="landscape" hoverable>
          <Image
            src={item.image}
            widths={featureWidths}
            sizes={featureSizes}
            alt=""
            width={900}
            height={675}
            loading={imgLoading}
            fetchpriority={imgFetchPriority}
            decoding={imgDecoding}
            class="h-full w-full object-cover"
          />
          {item.kind === "video" && (
            <div class="absolute inset-0 flex items-center justify-center">
              <div class="flex h-11 w-11 items-center justify-center rounded-full bg-white/95 transition-transform duration-200 group-hover:scale-110">
                <Fragment set:html={playIcon} />
              </div>
            </div>
          )}
        </MediaFrame>
      )}
      {bylineParts.length > 0 && <Meta items={bylineParts} />}
      <h3 class="font-serif text-3xl text-ink">
        {item.href ? (
          <a href={item.href} class="underline">
            {item.title}
          </a>
        ) : (
          item.title
        )}
      </h3>
      {item.description && (
        <p class="text-md text-ink-muted line-clamp-2 md:line-clamp-none">
          {item.description}
        </p>
      )}
      {item.href && (
        <p>
          <Button
            href={item.href}
            variant="accent"
            size="sm"
            class="hidden! md:inline-block! mt-4"
          >
            {ctaLabel}
          </Button>
        </p>
      )}
    </article>
  )
}

{
  format === "standard" && item.kind === "project" && (
    <article class="flex cursor-pointer flex-col gap-3 border border-line-dark bg-bg-dark-card p-7 transition-[transform,border-color] duration-200 hover:-translate-y-0.5 hover:border-line-dark-hover">
      {item.badge && (
        <span class="font-mono text-xs font-medium uppercase text-accent-bright">
          {item.badge}
        </span>
      )}
      <h3 class="font-serif text-2xl font-medium text-cream">{item.title}</h3>
      {item.description && (
        <p class="text-sm text-cream-muted">{item.description}</p>
      )}
      {item.meta && item.meta.length > 0 && (
        <p class="mt-auto pt-2 font-mono text-xs text-cream-subtle">
          {item.meta.join(" · ")}
        </p>
      )}
    </article>
  )
}

{
  format === "standard" && item.kind !== "project" && (
    <article class="group flex flex-col gap-2.5">
      {item.href ? (
        <a href={item.href} class="contents">
          <MediaFrame aspect="video" class="relative">
            {item.image && (
              <Image
                src={item.image}
                widths={standardWidths}
                sizes={standardSizes}
                alt=""
                width={640}
                height={360}
                loading={imgLoading}
                fetchpriority={imgFetchPriority}
                decoding={imgDecoding}
                class="h-full w-full object-cover absolute inset-0"
              />
            )}
            {item.kind === "video" && (
              <>
                <div class="absolute inset-0 flex items-center justify-center">
                  <div class="flex h-11 w-11 items-center justify-center rounded-full bg-white/95 transition-transform duration-200 group-hover:scale-110">
                    <Fragment set:html={playIcon} />
                  </div>
                </div>
                {item.duration && (
                  <span class="absolute bottom-2 right-2 rounded-sm bg-bg-dark/85 px-1.5 py-0.5 font-mono text-[11px] text-cream">
                    {item.duration}
                  </span>
                )}
              </>
            )}
          </MediaFrame>
          {item.kind === "video"
            ? item.badge && (
                <p class="text-xs tracking-wide text-ink-subtle">
                  {item.badge}
                </p>
              )
            : bylineParts.length > 0 && <Meta items={bylineParts} />}
          <h3
            class:list={[
              "font-serif font-medium text-ink leading-tight",
              item.kind === "video" ? "text-xl line-clamp-2" : "text-2xl",
            ]}
          >
            {item.title}
          </h3>
          {item.kind !== "video" && item.description && (
            <p class="text-sm text-ink-muted line-clamp-3">
              {item.description}
            </p>
          )}
          {item.kind === "article" && item.tags && item.tags.length > 0 && (
            <div class="mt-1 flex flex-wrap gap-2">
              {item.tags.slice(0, 3).map((label) => (
                <span class="rounded-full border border-line-strong px-2.5 py-0.5 text-[11px] tracking-wide text-ink-muted">
                  {label}
                </span>
              ))}
            </div>
          )}
        </a>
      ) : (
        <>
          <MediaFrame aspect="video">
            {item.image && (
              <Image
                src={item.image}
                widths={standardWidths}
                sizes={standardSizes}
                alt=""
                width={640}
                height={360}
                loading={imgLoading}
                fetchpriority={imgFetchPriority}
                decoding={imgDecoding}
                class="h-full w-full object-cover"
              />
            )}
          </MediaFrame>
          {bylineParts.length > 0 && <Meta items={bylineParts} />}
          <h3 class="font-serif text-2xl font-medium text-ink leading-tight">
            {item.title}
          </h3>
          {item.description && (
            <p class="text-sm text-ink-muted line-clamp-3">
              {item.description}
            </p>
          )}
        </>
      )}
    </article>
  )
}

{
  format === "row" && item.kind === "talk" && (
    <div
      class:list={[
        "grid grid-cols-1 items-baseline gap-2 border-t border-line py-6 md:grid-cols-[136px_1fr_auto] md:items-center md:gap-8",
        isLast && "border-b border-line",
      ]}
    >
      <span class="text-xs uppercase text-ink-subtle md:hidden">
        {item.date}
      </span>
      {item.dateParts && (
        <time
          class="hidden w-24 rounded-sm border border-line bg-bg-soft px-3 py-2.5 text-center md:flex md:flex-col md:items-center md:gap-1"
          datetime={item.dateISO}
        >
          <span class="font-serif text-4xl leading-none font-medium text-ink tabular-nums">
            {item.dateParts.day}
          </span>
          <span class="flex gap-1 text-[0.68rem] leading-tight font-medium tracking-wide text-ink-subtle uppercase">
            <span>{item.dateParts.month}</span>
            <span>{item.dateParts.year}</span>
          </span>
        </time>
      )}
      <div>
        <h3 class="mb-1 font-serif text-xl font-medium text-ink">
          {item.href ? (
            <a {...linkAttrs} class="hover:underline underline-offset-[3px]">
              {item.title}
              {item.external && (
                <>
                  <span aria-hidden="true" class="ml-1 text-accent">
                    ↗
                  </span>
                  <span class="sr-only"> (opens in a new tab)</span>
                </>
              )}
            </a>
          ) : (
            item.title
          )}
        </h3>
        {item.badge && <p class="text-sm text-ink-subtle">{item.badge}</p>}
      </div>
      {item.location && (
        <span class="text-xs tracking-wide whitespace-nowrap text-ink-subtle">
          {item.location}
        </span>
      )}
    </div>
  )
}

{
  format === "row" && item.kind === "article" && (
    <article class="group">
      <a
        {...linkAttrs}
        class="flex flex-col gap-2 border-t border-line py-6 no-underline md:flex-row md:items-baseline md:gap-8"
      >
        {item.date && (
          <time
            class="shrink-0 font-mono text-xs uppercase tracking-wide text-ink-subtle md:w-32"
            datetime={item.dateISO}
          >
            {item.date}
          </time>
        )}
        <div class="flex-1">
          <h3 class="font-serif text-2xl font-medium leading-tight text-ink group-hover:underline group-hover:underline-offset-[3px]">
            {item.title}
          </h3>
          {item.description && (
            <p class="mt-2 text-sm text-ink-muted line-clamp-2">
              {item.description}
            </p>
          )}
          {item.tags && item.tags.length > 0 && (
            <div class="mt-3 flex flex-wrap gap-2">
              {item.tags.slice(0, 4).map((label) => (
                <span class="rounded-full border border-line-strong px-2.5 py-0.5 text-[11px] tracking-wide text-ink-muted">
                  {label}
                </span>
              ))}
            </div>
          )}
        </div>
      </a>
    </article>
  )
}
