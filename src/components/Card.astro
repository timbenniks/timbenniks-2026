---
import CardFeature from "./cards/CardFeature.astro";
import CardStandard from "./cards/CardStandard.astro";
import CardRow from "./cards/CardRow.astro";
import type { CardItem } from "../lib/card";

export type CardFormat = "feature" | "standard" | "row";

interface Props {
  item: CardItem;
  format: CardFormat;
  isLast?: boolean;
  eager?: boolean;
}

const { item, format, isLast = false, eager = false } = Astro.props;
---

{format === "feature" && <CardFeature item={item} eager={eager} />}
{format === "standard" && <CardStandard item={item} eager={eager} />}
{format === "row" && <CardRow item={item} isLast={isLast} />}
