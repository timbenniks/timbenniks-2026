---
import { loadSiteChrome } from "../lib/site-chrome";

const { footerColumns, footerHuman, newsletter } = await loadSiteChrome();
---

<footer id="newsletter" class="border-t border-line bg-bg-warm pt-16 pb-8">
  <div class="mx-auto max-w-site px-6">
    <div
      class="mb-12 grid grid-cols-1 gap-10 sm:grid-cols-2 lg:grid-cols-[2fr_1fr_1fr_1fr]"
    >
      <div>
        <h3
          class="mb-2 font-serif text-2xl font-medium leading-tight tracking-[-0.01em] text-ink"
        >
          {newsletter.heading}
        </h3>
        <p class="mb-5 max-w-[360px] text-sm text-ink-muted">
          {newsletter.body}
        </p>
        <form class="flex max-w-[380px] gap-1.5" action="#" method="post">
          <input
            type="email"
            name="email"
            required
            placeholder="you@email.com"
            aria-label="Email address"
            class="flex-1 rounded-full border border-line-strong bg-transparent px-4 py-2.5 text-sm text-ink focus:border-ink focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent"
          />
          <button
            type="submit"
            class="cursor-pointer rounded-full border-0 bg-accent px-[18px] py-2.5 text-sm font-medium text-white transition-colors duration-150 hover:bg-accent-bright"
          >
            Subscribe
          </button>
        </form>
      </div>

      {
        footerColumns.map((col) => (
          <div>
            <h4 class="mb-4 text-xs font-medium uppercase tracking-widest text-ink-subtle">
              {col.heading}
            </h4>
            <ul class="flex flex-col gap-2">
              {col.links.map((link) => (
                <li>
                  <a
                    href={link.href}
                    class="text-sm text-ink no-underline hover:underline hover:underline-offset-[3px]"
                  >
                    {link.label}
                  </a>
                </li>
              ))}
            </ul>
          </div>
        ))
      }
    </div>

    <div
      class="flex flex-wrap items-center justify-between gap-4 border-t border-line pt-6 text-xs text-ink-subtle"
    >
      <p>&copy; Tim Benniks, {new Date().getFullYear()}</p>
      <p>{footerHuman}</p>
    </div>
  </div>
</footer>
