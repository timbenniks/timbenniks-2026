---
import HeroSection from "./sections/HeroSection.astro";
import QuoteCallout from "./sections/QuoteCallout.astro";
import FeatureSplitSection from "./sections/FeatureSplitSection.astro";
import CardGridSection from "./sections/CardGridSection.astro";
import CardRowsSection from "./sections/CardRowsSection.astro";
import ImageTextSection from "./sections/ImageTextSection.astro";
import CtaStrip from "./sections/CtaStrip.astro";
import TimelineSection from "./sections/TimelineSection.astro";
import FaqSection from "./sections/FaqSection.astro";
import StatsSection from "./sections/StatsSection.astro";
import BrowseSection from "./sections/BrowseSection.astro";
import InventorySection from "./sections/InventorySection.astro";
import CopyBlocksSection from "./sections/CopyBlocksSection.astro";
import PhotoGridSection from "./sections/PhotoGridSection.astro";
import TopicGridSection from "./sections/TopicGridSection.astro";
import FactsheetSection from "./sections/FactsheetSection.astro";
import type { AstroComponentFactory } from "astro/runtime/server/index.js";
import {
  resolvePageSections,
  type ResolvedPageSection,
} from "../lib/page-sections";
import { isEditMarkupEnabled } from "../lib/admin/edit-mode";
import { sectionEditAttrs } from "../lib/admin/edit-path";

interface Props {
  sections: Parameters<typeof resolvePageSections>[0];
}

const resolvedSections: ResolvedPageSection[] = await resolvePageSections(
  Astro.props.sections,
);
const editEnabled = isEditMarkupEnabled();

const sectionComponents: Record<
  ResolvedPageSection["kind"],
  AstroComponentFactory
> = {
  hero: HeroSection,
  "quote-callout": QuoteCallout,
  "feature-split": FeatureSplitSection,
  "card-grid": CardGridSection,
  "card-rows": CardRowsSection,
  "image-text": ImageTextSection,
  "cta-strip": CtaStrip,
  timeline: TimelineSection,
  faq: FaqSection,
  stats: StatsSection,
  browse: BrowseSection,
  inventory: InventorySection,
  "copy-blocks": CopyBlocksSection,
  "photo-grid": PhotoGridSection,
  "topic-grid": TopicGridSection,
  factsheet: FactsheetSection,
};
---

{
  resolvedSections.map((section, i) => {
    const Component = sectionComponents[section.kind];
    return (
      <div
        class:list={[editEnabled && "tb-ve-block"]}
        {...sectionEditAttrs(i, section.kind)}
      >
        <Component
          {...section}
          editBase={editEnabled ? `sections.${i}` : undefined}
        />
      </div>
    );
  })
}
