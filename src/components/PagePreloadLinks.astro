---
import { getImage } from "astro:assets";
import type { CollectionEntry } from "astro:content";

interface Props {
  sections: CollectionEntry<"pages">["data"]["sections"];
}

const { sections } = Astro.props;

const hero = sections.find((section) => section.kind === "hero");

const preloadSrc =
  hero?.kind === "hero"
    ? hero.image?.preload
      ? hero.image
      : hero.gallery?.[0]
        ? {
            src: hero.gallery[0].src,
            width: 1280,
            widths: [640, 960, 1280],
            alt: hero.gallery[0].alt,
          }
        : null
    : null;

const heroPreloaded = preloadSrc
  ? await getImage({
      src: preloadSrc.src,
      width: "widths" in preloadSrc && preloadSrc.widths ? preloadSrc.widths.at(-1)! : preloadSrc.width,
      widths: "widths" in preloadSrc ? preloadSrc.widths : undefined,
      alt: preloadSrc.alt,
    })
  : null;
---

{
  heroPreloaded && (
    <link
      rel="preload"
      as="image"
      imagesrcset={heroPreloaded.srcSet.attribute}
      imagesizes="(min-width: 768px) 50vw, 100vw"
      fetchpriority="high"
    />
  )
}
