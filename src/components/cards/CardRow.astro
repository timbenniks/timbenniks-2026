---
import { Image } from "astro:assets";
import MediaFrame from "../primitives/MediaFrame.astro";
import TagPill from "../primitives/TagPill.astro";
import type { CardItem } from "../../lib/card";

interface Props {
  item: CardItem;
  isLast?: boolean;
}

const { item, isLast = false } = Astro.props;

const thumbWidths = [320, 480, 640, 800];
const thumbSizes = "(min-width: 768px) 224px, 100vw";

const linkAttrs = item.href
  ? {
      href: item.href,
      ...(item.external
        ? { target: "_blank", rel: "noopener noreferrer" }
        : {}),
    }
  : null;
---

{item.kind === "talk" ? (
  <div
    class:list={[
      "grid grid-cols-1 items-baseline gap-2 border-t border-line py-6 md:grid-cols-[136px_1fr_auto] md:items-center md:gap-8",
      isLast && "border-b border-line",
    ]}
  >
    <time
      class:list={[
        "text-xs uppercase text-ink-subtle",
        item.dateParts &&
          "md:flex md:w-24 md:flex-col md:items-center md:gap-1 md:rounded-sm md:border md:border-line md:bg-bg-soft md:px-3 md:py-2.5 md:text-center md:text-[0px]",
      ]}
      datetime={item.dateISO}
    >
      {item.dateParts ? (
        <>
          <span class="md:font-serif md:text-4xl md:leading-none md:font-medium md:text-ink md:tabular-nums md:normal-case">
            {item.dateParts.day}
          </span>
          {' '}
          <span class="md:text-[0.68rem] md:leading-tight md:font-medium md:tracking-wide md:text-ink-subtle">
            {item.dateParts.month} {item.dateParts.year}
          </span>
        </>
      ) : (
        item.date
      )}
    </time>
    <div>
      <h3 class="mb-1 font-serif text-xl font-medium text-ink">
        {linkAttrs ? (
          <a {...linkAttrs} class="hover:underline underline-offset-[3px]">
            {item.title}
            {item.external && (
              <>
                <span aria-hidden="true" class="ml-1 text-accent">↗</span>
                <span class="sr-only"> (opens in a new tab)</span>
              </>
            )}
          </a>
        ) : (
          item.title
        )}
      </h3>
      {item.badge && <p class="text-sm text-ink-subtle">{item.badge}</p>}
      {item.description && (
        <details class="mt-3 text-sm text-ink-muted">
          <summary class="w-fit cursor-pointer text-ink underline decoration-line underline-offset-4">Talk details</summary>
          <p class="mt-2 max-w-prose">{item.description}</p>
          {item.tags && item.tags.length > 0 && <p class="mt-2">Topics: {item.tags.join(' · ')}</p>}
          {item.talkDetails?.format && <p class="mt-2">Format: {item.talkDetails.format}</p>}
          <div class="mt-2 flex flex-wrap gap-x-4 gap-y-2">
            {item.talkDetails?.recording_url && <a class="underline underline-offset-4" href={item.talkDetails.recording_url}>Watch or listen</a>}
            {item.talkDetails?.slides_url && <a class="underline underline-offset-4" href={item.talkDetails.slides_url}>Slides</a>}
            {item.talkDetails?.sources.map((url, index) => <a class="underline underline-offset-4" href={url}>Source {index + 1}</a>)}
          </div>
          {item.talkDetails?.metadata_checked && <p class="mt-2 text-xs text-ink-subtle">Sources checked {item.talkDetails.metadata_checked}</p>}
        </details>
      )}
    </div>
    {item.location && (
      <span class="text-xs tracking-wide whitespace-nowrap text-ink-subtle">
        {item.location}
      </span>
    )}
  </div>
) : (
  <article class="group">
    <a
      {...linkAttrs}
      class="flex flex-col gap-4 rounded-sm border-t border-line py-6 no-underline md:flex-row md:items-start md:gap-8"
    >
      {item.date && (
        <time
          class="shrink-0 font-mono text-xs uppercase tracking-wide text-ink-subtle md:w-32"
          datetime={item.dateISO}
        >
          {item.date}
        </time>
      )}
      {item.image && (
        <MediaFrame aspect="video" class="w-full shrink-0 md:w-56">
          <Image
            src={item.image}
            widths={thumbWidths}
            sizes={thumbSizes}
            alt={item.title}
            width={320}
            height={180}
            loading="lazy"
            decoding="async"
            class="h-full w-full object-cover"
          />
        </MediaFrame>
      )}
      <div class="flex-1">
        <h3 class="font-serif text-2xl font-medium leading-tight text-ink group-hover:underline group-hover:underline-offset-[3px]">
          {item.title}
        </h3>
        {item.description && (
          <p class="mt-2 text-sm text-ink-muted line-clamp-2">
            {item.description}
          </p>
        )}
        {item.tags && item.tags.length > 0 && (
          <ul class="mt-3 flex flex-wrap gap-2" role="list">
            {item.tags.slice(0, 4).map((label) => (
              <li>
                <TagPill size="sm">{label}</TagPill>
              </li>
            ))}
          </ul>
        )}
      </div>
    </a>
  </article>
)}
