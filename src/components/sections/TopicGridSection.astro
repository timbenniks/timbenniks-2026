---
import Section from '../primitives/Section.astro';
import SectionHeading from '../primitives/SectionHeading.astro';
import { editAttr, editPath } from '../../lib/admin/edit-path';

interface Props {
  editBase?: string;
  eyebrow?: string;
  title: string;
  lede?: string;
  items: { title: string; body: string }[];
  pills?: string[];
  pillsLabel?: string;
  noteBefore?: string;
  noteHref?: string;
  noteLinkLabel?: string;
  noteAfter?: string;
}

const {
  editBase,
  eyebrow,
  title,
  lede,
  items,
  pills = [],
  pillsLabel,
  noteBefore,
  noteHref,
  noteLinkLabel,
  noteAfter,
} = Astro.props;

const hasNote = Boolean(noteBefore || noteLinkLabel || noteAfter);
---

<Section bordered padding="lg">
  <SectionHeading editBase={editBase} eyebrow={eyebrow} title={title} lede={lede} />
  <div class="mt-12 grid grid-cols-1 gap-10 md:grid-cols-2 md:gap-12">
    {items.map((t, i) => (
      <div>
        <h3 class="font-serif text-2xl leading-snug text-ink" {...editAttr(editPath(editBase, 'items', i, 'title'))}>
          {t.title}
        </h3>
        <p class="mt-3 text-base text-ink-muted" {...editAttr(editPath(editBase, 'items', i, 'body'))}>
          {t.body}
        </p>
      </div>
    ))}
  </div>

  {(pills.length > 0 || hasNote) && (
    <div class="mt-16 border-t border-line pt-10">
      {pillsLabel && (
        <p
          class="font-mono text-xs uppercase tracking-wide text-ink-subtle"
          {...editAttr(editPath(editBase, 'pillsLabel'))}
        >
          {pillsLabel}
        </p>
      )}
      {pills.length > 0 && (
        <ul class:list={['flex flex-wrap gap-2', pillsLabel ? 'mt-4' : '']}>
          {pills.map((t) => (
            <li class="rounded-full border border-line-strong px-3 py-1 text-xs text-ink-muted">
              {t}
            </li>
          ))}
        </ul>
      )}
      {hasNote && (
        <p class="mt-6 text-sm text-ink-muted">
          {noteBefore && (
            <span {...editAttr(editPath(editBase, 'noteBefore'))}>{noteBefore}</span>
          )}
          {noteHref && noteLinkLabel ? (
            <a href={noteHref} class="underline" {...editAttr(editPath(editBase, 'noteLinkLabel'))}>
              {noteLinkLabel}
            </a>
          ) : (
            noteLinkLabel && (
              <span {...editAttr(editPath(editBase, 'noteLinkLabel'))}>{noteLinkLabel}</span>
            )
          )}
          {noteAfter && (
            <span {...editAttr(editPath(editBase, 'noteAfter'))}>{noteAfter}</span>
          )}
        </p>
      )}
    </div>
  )}
</Section>
