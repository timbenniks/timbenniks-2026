---
import Section from '../primitives/Section.astro';
import SectionHeading from '../primitives/SectionHeading.astro';
import { editAttr, editPath } from '../../lib/admin/edit-path';

type Item = { name: string; note?: string; href?: string };
type Group = { heading: string; items: Item[] };

interface Props {
  editBase?: string;
  eyebrow?: string;
  title: string;
  lede?: string;
  tone?: 'light' | 'dark';
  anchor?: string;
  groups: Group[];
}

const { editBase, eyebrow, title, lede, tone = 'light', groups, anchor } = Astro.props;
const dark = tone === 'dark';
---

<Section bordered padding="lg" tone={tone} id={anchor} class={anchor ? 'scroll-mt-36' : undefined}>
  <div class="grid grid-cols-1 gap-12 md:grid-cols-[1fr_1.4fr]">
    <div class="md:sticky md:top-24 md:self-start">
      <SectionHeading editBase={editBase} eyebrow={eyebrow} title={title} lede={lede} dark={dark} />
    </div>

    <div class="flex flex-col gap-10">
      {groups.map((g, gi) => (
        <div>
          <p
            class:list={[
              'font-mono text-xs uppercase tracking-wide',
              dark ? 'text-cream-subtle' : 'text-ink-subtle',
            ]}
            {...editAttr(editPath(editBase, 'groups', gi, 'heading'))}
          >
            {g.heading}
          </p>
          <ul class="mt-3 flex flex-col">
            {g.items.map((item, ii) => (
              <li
                class:list={[
                  'grid grid-cols-1 gap-1 py-3 md:grid-cols-[1fr_auto] md:items-baseline md:gap-6 border-b first:border-t',
                  dark ? 'border-line-dark' : 'border-line',
                ]}
              >
                <span
                  class:list={[
                    'font-serif text-lg leading-snug',
                    dark ? 'text-cream' : 'text-ink',
                  ]}
                  {...editAttr(editPath(editBase, 'groups', gi, 'items', ii, 'name'))}
                >
                  {item.href ? (
                    <a
                      href={item.href}
                      class:list={[
                        'no-underline underline-offset-[3px] hover:underline',
                        dark ? 'hover:text-accent-bright' : 'hover:text-accent',
                      ]}
                    >
                      {item.name}
                    </a>
                  ) : (
                    item.name
                  )}
                </span>
                {item.note && (
                  <span
                    class:list={[
                      'font-mono text-xs uppercase tracking-wide',
                      dark ? 'text-cream-subtle' : 'text-ink-subtle',
                    ]}
                    {...editAttr(editPath(editBase, 'groups', gi, 'items', ii, 'note'))}
                  >
                    {item.note}
                  </span>
                )}
              </li>
            ))}
          </ul>
        </div>
      ))}
    </div>
  </div>
</Section>
