---
import Section from '../primitives/Section.astro';
import SectionHeading from '../primitives/SectionHeading.astro';
import ArrowLink from '../primitives/ArrowLink.astro';
import Card from '../Card.astro';
import type { CardItem } from '../../lib/card';

type Tone = 'light' | 'dark';

interface Props {
  editBase?: string;
  eyebrow?: string;
  title?: string;
  lede?: string;
  items: CardItem[];
  columns?: 2 | 3;
  tone?: Tone;
  bordered?: boolean;
  cta?: { label: string; href: string };
  padding?: 'sm' | 'md' | 'lg' | 'xl';
  class?: string;
  pagefindIgnore?: boolean;
}

const {
  editBase,
  eyebrow,
  title,
  lede,
  items,
  columns = 3,
  tone = 'light',
  bordered = tone === 'light',
  cta,
  padding,
  class: className,
  pagefindIgnore = false,
} = Astro.props;

const gridCols = columns === 2 ? 'md:grid-cols-2' : 'md:grid-cols-2 lg:grid-cols-3';
const dark = tone === 'dark';
const showHeading = Boolean(eyebrow || title || lede);
---

<Section
  tone={tone}
  padding={padding ?? (dark ? 'lg' : 'md')}
  bordered={bordered}
  class={className}
>
  {showHeading && title && (
    <SectionHeading editBase={editBase} eyebrow={eyebrow} title={title} lede={lede} dark={dark} />
  )}

  <ul
    class:list={[
      'grid grid-cols-1 gap-5',
      showHeading && title ? 'mt-10' : '',
      gridCols,
      columns === 3 && 'gap-x-5 gap-y-10',
    ]}
    data-pagefind-ignore={pagefindIgnore ? true : undefined}
  >
    {items.map((item, i) => (
      <li>
        <Card item={item} format="standard" eager={i < 3} />
      </li>
    ))}
  </ul>

  {cta && (
    <div class="mt-10">
      <ArrowLink href={cta.href} dark={dark}>{cta.label}</ArrowLink>
    </div>
  )}
</Section>
