---
import { Image } from "astro:assets";
import Section from "../primitives/Section.astro";
import Button from "../primitives/Button.astro";
import { fullBleedWidths } from "../../lib/image-widths";
import { editAttr, editPath } from "../../lib/admin/edit-path";

type Tone = "light" | "dark";
type Align = "left" | "right";

interface Props {
  editBase?: string;
  headline: { lead: string; em: string; tail: string };
  attribution?: string;
  cta?: { label: string; href: string };
  tone?: Tone;
  align?: Align;
  backgroundImage?: {
    src: string;
    width: number;
    height: number;
    opacity?: number;
  };
}

const {
  editBase,
  headline,
  attribution,
  cta,
  tone = "dark",
  align = "left",
  backgroundImage,
} = Astro.props;
---

<Section tone={tone} padding="xl" class="relative isolate overflow-hidden">
  <p
    class:list={[
      "max-w-prose-lg font-serif font-normal text-5xl md:text-7xl",
      align === "right" && "md:ml-auto",
    ]}
  >
    <span {...editAttr(editPath(editBase, 'headline', 'lead'))}>{headline.lead}</span>
    <em class="font-normal italic" {...editAttr(editPath(editBase, 'headline', 'em'))}>{" "}{headline.em}{" "}</em>
    <span {...editAttr(editPath(editBase, 'headline', 'tail'))}>{headline.tail}</span>
  </p>
  {
    attribution && (
      <p
        class:list={[
          "mt-6 max-w-prose-lg text-xl",
          align === "right" && "md:ml-auto",
        ]}
        {...editAttr(editPath(editBase, 'attribution'))}
      >
        {attribution}
      </p>
    )
  }
  {
    cta && (
      <div
        class:list={["mt-8 max-w-prose-lg", align === "right" && "md:ml-auto"]}
      >
        <Button href={cta.href} variant="accent">
          <span {...editAttr(editPath(editBase, 'cta', 'label'))}>{cta.label}</span>
        </Button>
      </div>
    )
  }

  {
    backgroundImage && (
      <Image
        src={backgroundImage.src}
        widths={fullBleedWidths}
        sizes="100vw"
        alt=""
        aria-hidden="true"
        width={backgroundImage.width}
        height={backgroundImage.height}
        loading="lazy"
        decoding="async"
        class="mt-12 h-auto w-full object-cover md:absolute md:inset-0 md:-z-10 md:mt-0 md:h-full md:opacity-(--bg-opacity)"
        style={`--bg-opacity:${backgroundImage.opacity ?? 0.4}`}
        {...editAttr(editPath(editBase, 'backgroundImage', 'src'))}
      />
    )
  }
</Section>
