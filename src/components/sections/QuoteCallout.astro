---
import { Image } from 'astro:assets';
import Section from '../primitives/Section.astro';
import Button from '../primitives/Button.astro';

type Tone = 'light' | 'dark';

interface Props {
  headline: { lead: string; em: string; tail: string };
  attribution?: string;
  cta?: { label: string; href: string };
  tone?: Tone;
  backgroundImage?: { src: string; width: number; height: number; opacity?: number };
}

const { headline, attribution, cta, tone = 'dark', backgroundImage } = Astro.props;

const bgWidths = [1024, 1600, 2048, 2400];
---

<Section tone={tone} padding="xl" class="relative isolate overflow-hidden">
  {backgroundImage && (
    <Image
      src={backgroundImage.src}
      widths={bgWidths}
      sizes="100vw"
      alt=""
      aria-hidden="true"
      width={backgroundImage.width}
      height={backgroundImage.height}
      loading="lazy"
      decoding="async"
      class="object-cover absolute inset-0 -z-10 h-full w-full"
      style={`opacity:${backgroundImage.opacity ?? 0.4}`}
    />
  )}

  <p class="max-w-[700px] font-serif font-normal text-5xl md:text-7xl mt-24 md:mt-0">
    {headline.lead}
    <em class="font-normal italic">{headline.em}</em>
    {headline.tail}
  </p>
  {attribution && <p class="mt-6 max-w-[640px] text-xl">{attribution}</p>}
  {cta && (
    <div class="mt-8">
      <Button href={cta.href} variant="accent">{cta.label}</Button>
    </div>
  )}
</Section>
