---
import { Image } from "astro:assets";
import Section from "../primitives/Section.astro";
import Button from "../primitives/Button.astro";
import { heroSplitWidths } from "../../lib/image-widths";

type Variant = "primary" | "secondary" | "accent" | "ghost";
type ImageSide = "left" | "right";

interface Props {
  headline: { lead: string; em: string; tail: string };
  subline?: string;
  ctas?: { label: string; href: string; variant?: Variant }[];
  image?: {
    src: string;
    alt: string;
    width: number;
    height: number;
    widths?: number[];
    eager?: boolean;
  };
  imageSide?: ImageSide;
}

const { headline, subline, ctas = [], image, imageSide = "right" } = Astro.props;

const widths = image?.widths ?? heroSplitWidths;
---

<Section padding="lg">
  <div
    class:list={["grid grid-cols-1 items-center", image && "md:grid-cols-2"]}
  >
    <div
      class:list={[
        "max-w-[700px] mb-12 md:mb-0",
        imageSide === "left" && "md:order-2 md:ml-auto",
      ]}
    >
      <h1 class="font-serif text-6xl md:text-8xl">
        {headline.lead}
        <em class="italic text-accent">{headline.em}</em>
        {headline.tail}
      </h1>
      {subline && <p class="mt-8 text-xl text-ink-muted">{subline}</p>}
      {
        ctas.length > 0 && (
          <div class="mt-8 flex flex-wrap gap-3">
            {ctas.map((cta) => (
              <Button href={cta.href} variant={cta.variant ?? "primary"}>
                {cta.label}
              </Button>
            ))}
          </div>
        )
      }
    </div>

    {
      image && (
        <div
          class:list={[
            "flex items-center justify-center",
            imageSide === "left" && "md:order-1",
          ]}
        >
          <Image
            src={image.src}
            widths={widths}
            sizes="(min-width: 768px) 33vw, 100vw"
            alt={image.alt}
            width={image.width}
            height={image.height}
            loading={image.eager ? "eager" : "lazy"}
            fetchpriority={image.eager ? "high" : "auto"}
            decoding={image.eager ? "sync" : "async"}
            class="w-full max-h-[642px] object-contain"
          />
        </div>
      )
    }
  </div>
</Section>
