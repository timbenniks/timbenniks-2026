---
import Section from '../primitives/Section.astro';
import SectionHeading from '../primitives/SectionHeading.astro';
import ArrowLink from '../primitives/ArrowLink.astro';
import { thumbUrl, thumbSrcset } from '../../lib/cloudinary';

interface Props {
  eyebrow?: string;
  title: string;
  lede?: string;
  body?: string;
  image: { src: string; alt: string; width: number; height: number };
  imageSize?: number;
  cta?: { label: string; href: string };
  bordered?: boolean;
}

const { eyebrow, title, lede, body, image, imageSize = 300, cta, bordered = true } = Astro.props;

// 1×/2×/3× variants for the displayed size, plus a baseline for very small viewports.
const imgWidths = [imageSize, imageSize * 2, imageSize * 3];
const imgSrc = thumbUrl(image.src, imageSize * 2)!;
const imgSrcset = thumbSrcset(image.src, imgWidths)!;
---

<Section bordered={bordered}>
  <SectionHeading eyebrow={eyebrow} title={title} />

  <div
    class="mt-6 grid grid-cols-1 items-start gap-12 md:grid-cols-[var(--col)_1fr]"
    style={`--col:${imageSize}px`}
  >
    <div
      class="mx-auto flex aspect-square w-full items-center justify-center md:w-(--col)"
    >
      <img
        src={imgSrc}
        srcset={imgSrcset}
        sizes={`${imageSize}px`}
        alt={image.alt}
        width={image.width}
        height={image.height}
        loading="lazy"
        decoding="async"
        class="h-full w-full object-cover"
      />
    </div>

    <div>
      {lede && <p class="font-serif text-xl leading-snug text-ink">{lede}</p>}
      {body && <p class="mt-4 text-base text-ink-muted">{body}</p>}

      {cta && (
        <div class="mt-7">
          <ArrowLink href={cta.href}>{cta.label}</ArrowLink>
        </div>
      )}
    </div>
  </div>
</Section>
