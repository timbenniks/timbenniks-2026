---
import Container from '../primitives/Container.astro';
import { editAttr, editPath } from '../../lib/admin/edit-path';

interface Props {
  editBase?: string;
  label?: string;
  items: { label: string; href: string }[];
}

const { editBase, label = 'On this page', items } = Astro.props;
---

<nav class="border-b border-line bg-bg/90 backdrop-blur-md" aria-label={label}>
  <Container class="flex flex-wrap items-center gap-x-5 gap-y-2 py-3">
    <p
      class="font-mono text-[11px] uppercase tracking-wide text-ink-subtle"
      {...editAttr(editPath(editBase, 'label'))}
    >
      {label}
    </p>
    <ul class="flex flex-wrap items-center gap-x-4 gap-y-1">
      {items.map((item, i) => (
        <li>
          <a
            href={item.href}
            class="text-sm text-ink no-underline underline-offset-2 hover:underline"
            {...editAttr(editPath(editBase, 'items', i, 'label'))}
          >
            {item.label}
          </a>
        </li>
      ))}
    </ul>
  </Container>
</nav>
