---
import Container from '../primitives/Container.astro';
import Button from '../primitives/Button.astro';

interface Props {
  text: string;
  em?: string;
  cta: { label: string; href: string; variant?: 'primary' | 'secondary' | 'accent' };
}

const { text, em, cta } = Astro.props;
---

<Container as="section" class="flex flex-wrap items-center justify-between gap-8 pt-12 pb-20">
  <p class="max-w-[600px] font-serif font-normal text-2xl">
    {text}
    {em && <em class="text-accent italic font-normal">{em}</em>}
  </p>
  <Button href={cta.href} variant={cta.variant ?? 'accent'} size="lg">{cta.label}</Button>
</Container>
