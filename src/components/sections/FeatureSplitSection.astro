---
import Section from '../primitives/Section.astro';
import SectionHeading from '../primitives/SectionHeading.astro';
import ArrowLink from '../primitives/ArrowLink.astro';
import Card from '../Card.astro';
import type { CardItem } from '../../lib/card';
import { editAttr, editPath } from '../../lib/admin/edit-path';

interface Props {
  editBase?: string;
  eyebrow?: string;
  title: string;
  lede?: string;
  items: CardItem[];
  cta?: { label: string; href: string };
  bordered?: boolean;
}

const { editBase, eyebrow, title, lede, items, cta, bordered = true } = Astro.props;

const feature = items[0];
const standards = items.slice(1, 3);
---

<Section bordered={bordered}>
  <SectionHeading editBase={editBase} eyebrow={eyebrow} title={title} lede={lede} />

  <div class="mt-10 grid grid-cols-1 gap-12 lg:grid-cols-[1.4fr_1fr]">
    {feature && <Card item={feature} format="feature" />}

    <div class="flex flex-col gap-10">
      {standards.map((item) => <Card item={item} format="standard" />)}
    </div>
  </div>

  {cta && (
    <div class="mt-12">
      <ArrowLink href={cta.href}>
        <span {...editAttr(editPath(editBase, 'cta', 'label'))}>{cta.label}</span>
      </ArrowLink>
    </div>
  )}
</Section>
