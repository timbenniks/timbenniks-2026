---
import { loadSiteChrome } from '../lib/site-chrome';
import Button from './primitives/Button.astro';

const { nav, newsletter } = await loadSiteChrome();
const subscribeHref = newsletter.subscribeUrl || '#newsletter';
const subscribeTarget = newsletter.subscribeUrl ? '_blank' : undefined;
const subscribeRel = newsletter.subscribeUrl ? 'noopener noreferrer' : undefined;
const pathname = Astro.url.pathname;
const isActive = (href: string) => {
  if (href === '/') return pathname === '/';
  return pathname === href || pathname.startsWith(href + '/');
};

const linkClass = (href: string, mobile = false) => [
  mobile
    ? 'block border-b-4 pb-1 text-lg font-semibold text-ink no-underline'
    : 'border-b-4 pb-1 text-lg font-semibold text-ink no-underline transition-colors duration-150',
  isActive(href) ? 'border-accent' : 'border-transparent hover:border-line-strong',
];
---

<nav class="border-b border-line sticky top-0 bg-bg/85 z-50 backdrop-blur-md">
  <div class="mx-auto flex max-w-site items-center justify-between gap-4 px-6 py-5">
    <a href="/" class="font-serif text-3xl font-semibold text-ink no-underline">
      Tim Benniks
    </a>

    <ul class="hidden gap-5 lg:flex xl:gap-7">
      {nav.map((link) => (
        <li>
          <a href={link.href} class:list={linkClass(link.href)}>
            {link.label}
          </a>
        </li>
      ))}
    </ul>

    <div class="flex items-center gap-3">
      <a
        href="/search"
        class="inline-flex size-10 items-center justify-center rounded-full text-ink no-underline hover:bg-black/5 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent"
        aria-label="Search"
        data-astro-reload
        data-astro-prefetch="false"
      >
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <circle cx="11" cy="11" r="7"></circle>
          <path d="m20 20-3.5-3.5"></path>
        </svg>
      </a>
      <div class="hidden sm:block">
        <Button href={subscribeHref} target={subscribeTarget} rel={subscribeRel} variant="accent" size="md">Subscribe</Button>
      </div>
      <details class="relative lg:hidden">
        <summary
          class="flex size-10 cursor-pointer list-none items-center justify-center rounded-full text-ink hover:bg-black/5 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent [&::-webkit-details-marker]:hidden"
        >
          <span class="sr-only">Menu</span>
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
            <path d="M4 7h16M4 12h16M4 17h16"></path>
          </svg>
        </summary>
        <ul class="absolute right-0 z-50 mt-3 flex min-w-[220px] flex-col gap-3 rounded-lg border border-line bg-bg p-5">
          {nav.map((link) => (
            <li>
              <a href={link.href} class:list={linkClass(link.href, true)}>
                {link.label}
              </a>
            </li>
          ))}
          <li>
            <a href={subscribeHref} target={subscribeTarget} rel={subscribeRel} class:list={linkClass(subscribeHref, true)}>Subscribe</a>
          </li>
        </ul>
      </details>
    </div>
  </div>
</nav>

<script>
  declare global {
    interface Window {
      __tbNavMenuBound?: boolean;
    }
  }
  if (!window.__tbNavMenuBound) {
    window.__tbNavMenuBound = true;
    const closeMenu = () => {
      document.querySelectorAll('nav details[open]').forEach((el) => el.removeAttribute('open'));
    };
    document.addEventListener('astro:page-load', closeMenu);
    document.addEventListener('astro:before-swap', closeMenu);
  }
</script>
