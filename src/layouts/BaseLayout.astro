---
import { Font } from "astro:assets";
import { ClientRouter } from "astro:transitions";
import "../styles/global.css";
import SiteNav from "../components/SiteNav.astro";
import SiteFooter from "../components/SiteFooter.astro";
import SEO from "../components/primitives/SEO.astro";
import JsonLd from "../components/primitives/JsonLd.astro";
import { buildGraph, personSchema, websiteSchema, webPageSchema } from "../lib/schema";
import { isEditMarkupEnabled } from "../lib/admin/edit-mode";
import { pageCanonical } from "../lib/canonical";
import { inferredMarkdownHref } from "../lib/markdown";

interface Props {
  title: string;
  description: string;
  image?: string;
  imageAlt?: string;
  type?: "website" | "article";
  publishedTime?: Date | string;
  modifiedTime?: Date | string;
  tags?: string[];
  keywords?: string;
  canonical?: string;
  noindex?: boolean;
  markdownHref?: string;
}

const seoProps = Astro.props;
const originTrial = import.meta.env.PUBLIC_WEBMCP_ORIGIN_TRIAL_TOKEN as string | undefined;
const canonicalURL = seoProps.canonical ?? pageCanonical(Astro.url.pathname);
const markdownHref = seoProps.markdownHref ?? inferredMarkdownHref(Astro.url.pathname);
const baseGraph = buildGraph(
  webPageSchema({
    url: canonicalURL,
    name: seoProps.title,
    description: seoProps.description,
    hasBreadcrumb: true,
  }),
  websiteSchema(),
  personSchema(),
);
const editMarkupEnabled = isEditMarkupEnabled();
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <SEO {...seoProps} markdownHref={markdownHref} />
    {
      originTrial && (
        <meta http-equiv="origin-trial" content={originTrial} />
      )
    }
    <Font cssVariable="--font-fraunces" preload />
    <Font cssVariable="--font-inter" preload />
    <script is:inline>
      // Search loads Pagefind at runtime; ClientRouter + Vite prefetch can
      // infinite-loop that import and kill the tab. Force a full navigation.
      document.addEventListener(
        'click',
        function (event) {
          var el = event.target;
          if (!el || !el.closest) return;
          var link = el.closest('a[href]');
          if (!link) return;
          var href = link.getAttribute('href');
          if (!href) return;
          var path;
          try {
            path = new URL(href, location.href).pathname;
          } catch (e) {
            return;
          }
          if (path === '/search' || path === '/search/') {
            link.setAttribute('data-astro-reload', '');
            link.setAttribute('data-astro-prefetch', 'false');
          }
        },
        true,
      );
    </script>
    <ClientRouter />
    {
      import.meta.env.PROD && (
        <script
          defer
          is:inline
          data-domain="timbenniks.dev"
          src="https://plausible.io/js/script.js"
        />
      )
    }
    <JsonLd data={baseGraph} />
    <slot name="head" />
    {
      // Only when edit markup is enabled (admin preview SSR, or TB_EDIT_MODE).
      // Bridge: ?edit=1 iframes. Hotspots: live site hover CTAs → admin editor.
      editMarkupEnabled && (
        <script is:inline type="module">
          const params = new URLSearchParams(location.search);
          const inEditFrame = params.get('edit') === '1' && window.parent !== window;
          if (inEditFrame) {
            import('/admin/bridge.js');
          } else {
            import('/admin/edit-hotspots.js');
          }
        </script>
      )
    }
  </head>
  <body class="bg-bg text-ink antialiased">
    <a
      href="#main-content"
      class="sr-only focus:not-sr-only focus:fixed focus:left-4 focus:top-4 focus:z-50 focus:rounded-md focus:bg-ink focus:px-4 focus:py-2 focus:font-medium focus:text-bg focus:no-underline"
    >
      Skip to main content
    </a>
    <SiteNav />
    <main id="main-content" tabindex="-1">
      <slot />
    </main>
    <SiteFooter />
    <script src="../scripts/public-webmcp.ts"></script>
  </body>
</html>
