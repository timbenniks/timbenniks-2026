---
import { Font } from "astro:assets";
import { ClientRouter } from "astro:transitions";
import "../styles/global.css";
import SiteNav from "../components/SiteNav.astro";
import SiteFooter from "../components/SiteFooter.astro";
import SEO from "../components/primitives/SEO.astro";
import JsonLd from "../components/primitives/JsonLd.astro";
import { buildGraph, personSchema, websiteSchema, webPageSchema } from "../lib/schema";

interface Props {
  title: string;
  description: string;
  image?: string;
  imageAlt?: string;
  type?: "website" | "article";
  publishedTime?: Date | string;
  modifiedTime?: Date | string;
  tags?: string[];
  keywords?: string;
  canonical?: string;
  noindex?: boolean;
}

const seoProps = Astro.props;
const canonicalURL = seoProps.canonical ?? new URL(Astro.url.pathname, Astro.site).href;
const baseGraph = buildGraph(
  webPageSchema({
    url: canonicalURL,
    name: seoProps.title,
    description: seoProps.description,
    hasBreadcrumb: true,
  }),
  websiteSchema(),
  personSchema(),
);
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <SEO {...seoProps} />
    <Font cssVariable="--font-fraunces" preload />
    <Font cssVariable="--font-inter" preload />
    <ClientRouter />
    {
      import.meta.env.PROD && (
        <script
          defer
          is:inline
          data-domain="timbenniks.dev"
          src="https://plausible.io/js/script.js"
        />
      )
    }
    <JsonLd data={baseGraph} />
    <slot name="head" />
  </head>
  <body class="bg-bg text-ink antialiased">
    <a
      href="#main-content"
      class="sr-only focus:not-sr-only focus:fixed focus:left-4 focus:top-4 focus:z-50 focus:rounded-md focus:bg-ink focus:px-4 focus:py-2 focus:font-medium focus:text-bg focus:no-underline"
    >
      Skip to main content
    </a>
    <SiteNav />
    <main id="main-content" tabindex="-1">
      <slot />
    </main>
    <SiteFooter />
  </body>
</html>
