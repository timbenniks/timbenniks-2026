---
export const prerender = false;

import { getCollection } from 'astro:content';
import { SECTION_KINDS, type PageId } from '../../../lib/page-schema';
import {
  getPagePath,
  isAdminPageId,
  readPagesForAdmin,
} from '../../../lib/admin/pages-store';
import { CANONICAL_TAGS, TAG_LABELS } from '../../../lib/tags';

const id = Astro.params.id ?? '';
if (!(await isAdminPageId(id))) {
  return Astro.redirect('/admin');
}
const pageId = id as PageId;
const all = await readPagesForAdmin();
const page = all[pageId];
if (!page) {
  return Astro.redirect('/admin');
}

const liveUrl = getPagePath(page, pageId);
const previewUrl = `/admin/preview/${pageId}?edit=1`;
const videoEntries = await getCollection('videos');
const playlists = [
  ...new Set(videoEntries.map((e) => e.data.playlist).filter(Boolean)),
].sort((a, b) => a.localeCompare(b));

const initial = JSON.stringify({
  id: pageId,
  page,
  previewUrl,
  liveUrl,
  sectionKinds: SECTION_KINDS,
  canonicalTags: CANONICAL_TAGS.map((slug) => ({
    value: slug,
    label: TAG_LABELS[slug],
  })),
  playlists: playlists.map((value) => ({ value, label: value })),
  cloudinary: {
    cloudName:
      import.meta.env.PUBLIC_CLOUDINARY_CLOUD_NAME || 'dwfcofnrd',
  },
});
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Edit · {pageId}</title>
    <link rel="stylesheet" href="/admin/editor.css" />
    <!-- MCP-B WebMCP polyfill: document.modelContext + extension bridge -->
    <script is:inline>
      window.__webModelContextOptions = {
        autoInitialize: true,
        nativeModelContextBehavior: 'preserve',
        installTestingShim: 'if-missing',
      };
    </script>
    <script is:inline src="/admin/vendor/mcp-b-global.iife.js"></script>
  </head>
  <body>
    <div id="app" data-initial={initial}></div>
    <script is:inline type="module" src="/admin/editor.js"></script>
    <script is:inline type="module" src="/admin/webmcp-tools.js"></script>
    <script is:inline type="module" src="/admin/webmcp-agent.js"></script>
  </body>
</html>
