---
export const prerender = false;

import AdminLayout from '../../components/admin/AdminLayout.astro';
import { hasGitHubConfig, mainBranch } from '../../lib/admin/github-git';

const configured = hasGitHubConfig();
const main = mainBranch();
---

<AdminLayout title="Admin · Changes" active="changes" changesDesc={`drafts → ${main}`}>
  <Fragment slot="actions">
    <span class="chip" id="chip">Loading…</span>
  </Fragment>

  <div class="dash-intro">
    <h2>Changes</h2>
    <p>
      Review local drafts stored in this browser, then publish content files into
      <code>{main}</code> (Vercel deploys from main). Discard clears drafts without touching Git.
    </p>
  </div>

  {
    !configured && (
      <div class="changes-banner is-warn" id="config-banner">
        Set <code>GITHUB_TOKEN</code> and <code>GITHUB_REPO</code> to publish drafts to GitHub
        <code>{main}</code>. Without them, Publish writes the local working tree only.
      </div>
    )
  }

  <p class="status" id="status">Loading drafts…</p>

  <div class="changes-summary" id="summary" hidden></div>

  <section class="panel" id="pages-panel" hidden>
    <div class="panel-head"><h2>Pages</h2></div>
    <ul class="changes-list" id="pages-list"></ul>
  </section>

  <section class="panel" id="site-panel" hidden>
    <div class="panel-head"><h2>Site chrome</h2></div>
    <p class="hint" id="site-hint">Local draft differs from published site.json.</p>
  </section>

  <section class="panel" id="publish-panel">
    <div class="panel-head"><h2>Publish</h2></div>
    <div class="field">
      <label for="commit-msg">Commit message</label>
      <input
        id="commit-msg"
        value="content: publish drafts"
        autocomplete="off"
      />
    </div>
    <div class="changes-actions">
      <button type="button" class="primary" id="publish" disabled>
        Publish to {main}
      </button>
      <button type="button" class="ghost danger" id="discard" disabled>
        Discard all drafts
      </button>
    </div>
  </section>

  <script slot="scripts" is:inline type="module" src="/admin/changes.js"></script>
</AdminLayout>
