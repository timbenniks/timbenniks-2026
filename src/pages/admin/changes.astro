---
export const prerender = false;

import AdminLayout from '../../components/admin/AdminLayout.astro';
import { cmsBranch, hasGitHubConfig, mainBranch } from '../../lib/admin/github-git';

const configured = hasGitHubConfig();
const main = mainBranch();
const cms = cmsBranch();
---

<AdminLayout title="Admin · Changes" active="changes" changesDesc={`${cms} → ${main}`}>
  <Fragment slot="actions">
    <span class="chip" id="chip">Loading…</span>
  </Fragment>

  <div class="dash-intro">
    <h2>Changes</h2>
    <p>
      Review pending saves on <code>{cms}</code>, then publish a merge into
      <code>{main}</code> (Vercel deploys from main).
    </p>
  </div>

  {
    !configured && (
      <div class="changes-banner is-warn" id="config-banner">
        Set <code>GITHUB_TOKEN</code> and <code>GITHUB_REPO</code> to use the git CMS workflow. Saves
        without a token only update the local working tree.
      </div>
    )
  }

  <p class="status" id="status">Loading compare…</p>

  <div class="changes-summary" id="summary" hidden></div>

  <section class="panel" id="pages-panel" hidden>
    <div class="panel-head"><h2>Pages</h2></div>
    <ul class="changes-list" id="pages-list"></ul>
  </section>

  <section class="panel" id="files-panel" hidden>
    <div class="panel-head"><h2>Files</h2></div>
    <div id="files-list"></div>
  </section>

  <section class="panel" id="publish-panel">
    <div class="panel-head"><h2>Publish</h2></div>
    <div class="field">
      <label for="commit-msg">Merge commit message</label>
      <input
        id="commit-msg"
        value="content: publish cms changes"
        autocomplete="off"
      />
    </div>
    <div class="changes-actions">
      <button type="button" class="primary" id="publish" disabled>
        Publish to {main}
      </button>
      <button type="button" class="ghost danger" id="discard" disabled>
        Discard all on {cms}
      </button>
    </div>
  </section>

  <script slot="scripts" is:inline type="module" src="/admin/changes.js"></script>
</AdminLayout>
