---
export const prerender = false;

import AdminLayout from '../../components/admin/AdminLayout.astro';
import {
  mainBranch,
  preferLocalWorkingTree,
  usesGitHubCms,
} from '../../lib/admin/github-git';

const viaGitHub = usesGitHubCms();
const localDev = preferLocalWorkingTree();
const main = viaGitHub ? mainBranch() : 'local';
const publishLabel = viaGitHub ? `Publish to ${main}` : 'Publish to working tree';
---

<AdminLayout
  title="Admin · Changes"
  active="changes"
  changesDesc={viaGitHub ? `drafts → ${main}` : 'drafts → disk'}
>
  <Fragment slot="actions">
    <span class="chip" id="chip">Loading…</span>
  </Fragment>

  <div class="dash-intro">
    <h2>Changes</h2>
    <p>
      {
        localDev ? (
          <>
            Review local drafts stored in this browser (expand each for a JSON diff against
            on-disk content), then publish straight into
            <code>src/content/*.json</code>. Commit and push when you want those changes on
            GitHub / production.
          </>
        ) : (
          <>
            Review local drafts stored in this browser (expand each for a JSON diff against
            published content), then publish into
            <code>{main}</code> (Vercel deploys from main). Discard clears drafts without
            touching Git.
          </>
        )
      }
    </p>
  </div>

  {
    localDev ? (
      <div class="changes-banner" id="config-banner">
        Local <code>astro dev</code>: Publish writes JSON files on disk (even if
        <code>GITHUB_TOKEN</code> is set). Production admin uses the GitHub publish flow.
      </div>
    ) : !viaGitHub ? (
      <div class="changes-banner is-warn" id="config-banner">
        Set <code>GITHUB_TOKEN</code> and <code>GITHUB_REPO</code> to publish drafts to GitHub
        <code>{mainBranch()}</code>.
      </div>
    ) : null
  }

  <p class="status" id="status">Loading drafts…</p>

  <div class="changes-summary" id="summary" hidden></div>

  <section class="panel" id="pages-panel" hidden>
    <div class="panel-head"><h2>Pages</h2></div>
    <ul class="changes-list" id="pages-list"></ul>
  </section>

  <section class="panel" id="site-panel" hidden>
    <div class="panel-head"><h2>Site chrome</h2></div>
    <div id="site-diff"></div>
  </section>

  <section class="panel" id="publish-panel">
    <div class="panel-head"><h2>Publish</h2></div>
    <div class="field">
      <label for="commit-msg">{localDev ? 'Note (optional)' : 'Commit message'}</label>
      <input
        id="commit-msg"
        value="content: publish drafts"
        autocomplete="off"
      />
    </div>
    <div class="changes-actions">
      <button type="button" class="primary" id="publish" disabled>
        {publishLabel}
      </button>
      <button type="button" class="ghost danger" id="discard" disabled>
        Discard all drafts
      </button>
    </div>
  </section>

  <script slot="scripts" is:inline type="module" src="/admin/changes.js"></script>
</AdminLayout>
