---
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import Section from '../components/primitives/Section.astro';
import SectionHeading from '../components/primitives/SectionHeading.astro';
import Container from '../components/primitives/Container.astro';
import Button from '../components/primitives/Button.astro';
import JsonLd from '../components/primitives/JsonLd.astro';
import { breadcrumbSchema, buildGraph } from '../lib/schema';
import { headshotPrimaryWidths, cardThirdsWidths } from '../lib/image-widths';

const graph = buildGraph(
  breadcrumbSchema([
    { name: 'home', url: 'https://timbenniks.dev/' },
    { name: 'press-kit', url: 'https://timbenniks.dev/press-kit' },
  ]),
);

const headshots = [
  {
    src: 'https://res.cloudinary.com/dwfcofnrd/image/upload/Tim/tim_june_2024.jpg',
    alt: 'Tim Benniks portrait, June 2024',
    aspect: 'aspect-4/5',
    label: 'Studio portrait · 2024',
  },
  {
    src: 'https://res.cloudinary.com/dwfcofnrd/image/upload/presskit/tim_aug_2023_no_logo.png',
    alt: 'Tim Benniks portrait, August 2023',
    aspect: 'aspect-4/5',
    label: 'Studio portrait · 2023',
  },
  {
    src: 'https://res.cloudinary.com/dwfcofnrd/image/upload/presskit/IMG_0144',
    alt: 'Tim Benniks candid portrait',
    aspect: 'aspect-4/5',
    label: 'On-location · 2024',
  },
];

const headshotWidths = headshotPrimaryWidths;

const onStage = [
  {
    src: 'https://res.cloudinary.com/dwfcofnrd/image/upload/Presskit/FDLC2019_462.jpg',
    alt: 'Tim Benniks speaking at FDLC',
    label: 'FDLC keynote',
  },
  {
    src: 'https://res.cloudinary.com/dwfcofnrd/image/upload/Tim/IMG_1020.jpg',
    alt: 'Tim Benniks on stage',
    label: 'Conference talk',
  },
  {
    src: 'https://res.cloudinary.com/dwfcofnrd/image/upload/website/tim_on_stage.png',
    alt: 'Tim Benniks on stage in front of a live audience',
    label: 'Live audience',
  },
];

const onStageWidths = cardThirdsWidths;

const topics = [
  {
    title: 'Developer experience as product strategy',
    body: 'Why DX is no longer polish on top of the platform — it is the platform. How to instrument, design, and prioritize it with real engineering rigor.',
  },
  {
    title: 'AI-augmented engineering',
    body: 'What changes when generation cost goes to zero. Taste as a technical skill, the new bottlenecks, and the team shapes that win.',
  },
  {
    title: 'Composable architecture, beyond the buzzword',
    body: 'MACH, headless, and the real wiring that makes composable systems shippable in the enterprise — including where they break.',
  },
  {
    title: 'Agents at the content layer',
    body: 'How MCP, agent skills, and headless content infrastructure meet. What enterprises actually do with agents once the demo is over.',
  },
];

const pastTalks = [
  'vuejs.amsterdam · keynote',
  'JAMstack Conf · headless DXP',
  'Headless Conf · agents at the content layer',
  'DevWorld Conference · AI-augmented DevRel',
  'Contentstack ContentCon · keynote',
  'AI4DEVS Amsterdam · taste as a technical skill',
];

const factsheet = [
  { term: 'Name', value: 'Tim Benniks' },
  { term: 'Title', value: 'Developer Experience Lead, Contentstack' },
  { term: 'Co-chair', value: 'MACH Alliance · Enterprise AI Agents Workgroup' },
  { term: 'Ambassador', value: 'Nuxt · Cloudinary · Supabase · Algolia' },
  { term: 'Based in', value: 'Greater Toulouse, France' },
  { term: 'Languages', value: 'English, Dutch, French' },
  { term: 'Email', value: 'hi@timbenniks.dev', href: 'mailto:hi@timbenniks.dev' },
  { term: 'LinkedIn', value: 'linkedin.com/in/timbenniks', href: 'https://linkedin.com/in/timbenniks' },
];

const shortBio =
  "Developer Experience and Product leader at Contentstack, where he drives DX, Developer Hub & Marketplace, MCP, and Agent Skills. With 20 years of experience building for global brands, he now focuses on shaping developer-facing products and AI-driven workflows. Tim is a frequent speaker, content creator, and Co-chair of the Enterprise AI Agents Workgroup at the MACH Alliance.";

const longBio =
  "Tim Benniks is a Developer Experience and Product leader with over 20 years of experience building digital platforms for some of the world's biggest brands, including Nike, Google, CHANEL, Louis Vuitton, and Procter & Gamble. He currently leads Developer Experience at Contentstack, where he also operates as Product Manager across Developer Experience, Developer Hub & Marketplace, Contentstack MCP, and Agent Skills. His work sits at the intersection of product, developers, and emerging AI workflows — with a focus on making complex systems usable, scalable, and actually enjoyable to build with.";
---

<BaseLayout
  title="Press kit & booking"
  description="Bios, headshots, on-stage photos, speaker topics, and contact details for booking Tim Benniks for conferences, podcasts, and developer events."
  keywords="press kit, speaker bio, headshots, booking, conference speaker, keynote, podcast guest"
  image="https://res.cloudinary.com/dwfcofnrd/image/upload/q_auto,f_auto,w_1280/Presskit/tim_aug_2023_no_logo.png"
>
  <JsonLd slot="head" data={graph} />

  <Section padding="lg">
    <div class="grid grid-cols-1 gap-12 md:grid-cols-[1fr_1.1fr] md:items-center">
      <div class="max-w-[600px]">
        <p class="font-mono text-xs uppercase tracking-wide text-ink-subtle">Press kit</p>
        <h1 class="mt-4 font-serif text-6xl md:text-7xl leading-tight">
          Booking, bios, and the
          <em class="italic text-accent">good photos.</em>
        </h1>
        <p class="mt-8 text-xl text-ink-muted">
          Everything you need to introduce me on stage, on a panel, or in your show notes — without
          having to email me twice.
        </p>
        <div class="mt-8 flex flex-wrap gap-3">
          <Button href="mailto:hi@timbenniks.dev" variant="primary">Email Tim</Button>
          <Button
            href="https://linkedin.com/in/timbenniks"
            variant="secondary"
            target="_blank"
            rel="noopener noreferrer"
          >
            LinkedIn
          </Button>
        </div>
      </div>

      <div class="grid grid-cols-3 gap-3">
        {headshots.map((h, i) => (
          <a
            href={h.src}
            target="_blank"
            rel="noopener noreferrer"
            class:list={[
              'group relative overflow-hidden border border-line bg-bg-soft',
              h.aspect,
              i === 0 && 'col-span-2 row-span-2 aspect-4/5',
            ]}
          >
            <Image
              src={h.src}
              widths={headshotWidths}
              sizes={i === 0 ? '(min-width: 768px) 50vw, 66vw' : '(min-width: 768px) 16vw, 33vw'}
              width={1280}
              height={1600}
              alt={h.alt}
              loading={i === 0 ? 'eager' : 'lazy'}
              fetchpriority={i === 0 ? 'high' : 'auto'}
              decoding={i === 0 ? 'sync' : 'async'}
              class="h-full w-full object-cover transition-transform duration-300 group-hover:scale-[1.02]"
            />
            <span class="absolute bottom-2 left-2 rounded-sm bg-bg-dark/80 px-2 py-1 font-mono text-[10px] uppercase tracking-wide text-cream opacity-0 transition-opacity group-hover:opacity-100">
              {h.label}
            </span>
          </a>
        ))}
      </div>
    </div>
  </Section>

  <Section bordered padding="lg">
    <SectionHeading
      eyebrow="The bios"
      title="Copy and paste"
      lede="Two lengths, both written to be lifted directly. Pronouns: he/him."
    />
    <div class="mt-12 grid grid-cols-1 gap-10 md:grid-cols-2 md:gap-16">
      <div>
        <p class="font-mono text-xs uppercase tracking-wide text-ink-subtle">Short · 60 words</p>
        <p class="mt-4 font-serif text-xl leading-snug text-ink">{shortBio}</p>
      </div>
      <div>
        <p class="font-mono text-xs uppercase tracking-wide text-ink-subtle">Long · 110 words</p>
        <p class="mt-4 text-base leading-relaxed text-ink-muted">{longBio}</p>
      </div>
    </div>
  </Section>

  <Section tone="dark" padding="lg">
    <SectionHeading
      eyebrow="On stage"
      title="Photos for show notes"
      lede="Click to open at full resolution. Credit isn't required, but a Bluesky tag never hurts."
      dark
    />
    <div class="mt-12 grid grid-cols-1 gap-5 md:grid-cols-3">
      {onStage.map((p) => (
        <a
          href={p.src}
          target="_blank"
          rel="noopener noreferrer"
          class="group relative aspect-video overflow-hidden border border-line-dark"
        >
          <Image
            src={p.src}
            widths={onStageWidths}
            sizes="(min-width: 768px) 33vw, 100vw"
            width={1600}
            height={900}
            alt={p.alt}
            loading="lazy"
            decoding="async"
            class="h-full w-full object-cover transition-transform duration-300 group-hover:scale-[1.02]"
          />
          <span class="absolute bottom-2 left-2 rounded-sm bg-bg-dark/80 px-2 py-1 font-mono text-[10px] uppercase tracking-wide text-cream">
            {p.label}
          </span>
        </a>
      ))}
    </div>
  </Section>

  <Section bordered padding="lg">
    <SectionHeading
      eyebrow="Speaker topics"
      title="What I talk about"
      lede="Keynotes, technical deep-dives, and panel topics. Every talk is rebuilt for the audience — these are starting points, not a fixed deck."
    />
    <div class="mt-12 grid grid-cols-1 gap-10 md:grid-cols-2 md:gap-12">
      {topics.map((t) => (
        <div>
          <h3 class="font-serif text-2xl leading-snug text-ink">{t.title}</h3>
          <p class="mt-3 text-base text-ink-muted">{t.body}</p>
        </div>
      ))}
    </div>

    <div class="mt-16 border-t border-line pt-10">
      <p class="font-mono text-xs uppercase tracking-wide text-ink-subtle">Recent stages</p>
      <ul class="mt-4 flex flex-wrap gap-2">
        {pastTalks.map((t) => (
          <li class="rounded-full border border-line-strong px-3 py-1 text-xs text-ink-muted">{t}</li>
        ))}
      </ul>
      <p class="mt-6 text-sm text-ink-muted">
        See <a href="/speaking" class="underline">all talks</a> for the full list — over 100 events
        across the last six years.
      </p>
    </div>
  </Section>

  <Section bordered padding="lg">
    <Container padded={false}>
      <div class="grid grid-cols-1 gap-12 md:grid-cols-[1fr_1.2fr]">
        <div>
          <SectionHeading
            eyebrow="The factsheet"
            title="Everything else"
            lede="The details for your CRM, your event ops sheet, or your producer."
          />
        </div>
        <dl class="flex flex-col">
          {factsheet.map((row, i) => (
            <div
              class:list={[
                'grid grid-cols-1 gap-1 border-line py-5 md:grid-cols-[160px_1fr] md:gap-8 border-b',
                i === 0 && 'border-t',
              ]}
            >
              <dt class="font-mono text-xs uppercase tracking-wide text-ink-subtle md:pt-1">
                {row.term}
              </dt>
              <dd class="font-serif text-lg leading-snug text-ink">
                {row.href ? (
                  <a href={row.href} class="underline underline-offset-[3px] hover:text-accent">
                    {row.value}
                  </a>
                ) : (
                  row.value
                )}
              </dd>
            </div>
          ))}
        </dl>
      </div>
    </Container>
  </Section>

  <Container as="section" class="flex flex-wrap items-center justify-between gap-8 pt-12 pb-20">
    <p class="max-w-[600px] font-serif text-2xl">
      Got a stage, a podcast, or a developer team that needs sharpening?
      <em class="italic font-normal text-accent">Let's talk.</em>
    </p>
    <div class="flex flex-wrap gap-3">
      <Button href="mailto:hi@timbenniks.dev" variant="accent" size="lg">Email Tim</Button>
      <Button
        href="https://linkedin.com/in/timbenniks"
        variant="secondary"
        size="lg"
        target="_blank"
        rel="noopener noreferrer"
      >
        LinkedIn
      </Button>
    </div>
  </Container>
</BaseLayout>
