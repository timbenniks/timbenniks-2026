---
import { getCollection, render, type CollectionEntry } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Section from '../../components/primitives/Section.astro';
import Container from '../../components/primitives/Container.astro';
import Eyebrow from '../../components/primitives/Eyebrow.astro';
import ArrowLink from '../../components/primitives/ArrowLink.astro';
import Button from '../../components/primitives/Button.astro';
import JsonLd from '../../components/primitives/JsonLd.astro';
import AuthorByline from '../../components/primitives/AuthorByline.astro';
import RelatedCards from '../../components/RelatedCards.astro';
import { breadcrumbSchema, buildGraph, softwareSchema } from '../../lib/schema';
import { projectToCard } from '../../lib/card';
import { articleBodyClass } from '../../lib/articleBodyClass';
import { relatedProjects } from '../../lib/relatedProjects';
import { siteUrl } from '../../data/site';

export async function getStaticPaths() {
  const entries = await getCollection('projects');
  return entries.map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}

interface Props {
  entry: CollectionEntry<'projects'>;
}
const { entry } = Astro.props;
const { Content } = await render(entry);
const { title, tag, description, meta, github, live, docs, npm } = entry.data;

const links = [
  live && { label: 'Live site', href: live, primary: true },
  github && { label: 'GitHub', href: github, primary: !live },
  docs && { label: 'Docs', href: docs, primary: false },
  npm && {
    label: 'npm',
    href: `https://www.npmjs.com/package/${npm}`,
    primary: false,
  },
].filter(Boolean) as { label: string; href: string; primary: boolean }[];

const allProjects = await getCollection('projects');
const related = relatedProjects(entry, allProjects).map(projectToCard);

const url = siteUrl(`/projects/${entry.id}`);
const graph = buildGraph(
  softwareSchema({
    url,
    name: title,
    description,
    github,
    live,
    npm,
  }),
  breadcrumbSchema([
    { name: 'home', url: siteUrl('/') },
    { name: 'projects', url: siteUrl('/projects') },
    { name: title.toLowerCase(), url },
  ]),
);
---

<BaseLayout
  title={title}
  description={description}
  keywords={tag}
>
  <JsonLd slot="head" data={graph} />

  <Section tone="dark" padding="xl">
    <Container padded={false}>
      <Eyebrow>
        <a href="/projects" class="text-accent-bright hover:underline">← All projects</a>
      </Eyebrow>
      <p class="mt-6 font-mono text-xs font-medium uppercase tracking-wide text-accent-bright">
        {tag}
      </p>
      <h1 class="mt-4 max-w-[820px] font-serif text-5xl leading-tight text-cream md:text-6xl">
        {title}
      </h1>
      <p class="mt-6 max-w-[680px] text-xl text-cream-muted">{description}</p>
      <p class="mt-6 font-mono text-xs uppercase tracking-wide text-cream-subtle">{meta}</p>
      {
        links.length > 0 && (
          <div class="mt-8 flex flex-wrap gap-3">
            {links.map((l) => (
              <Button
                href={l.href}
                variant={l.primary ? 'accent' : 'ghost'}
                size="sm"
                target="_blank"
                rel="noopener"
              >
                {l.label} ↗
              </Button>
            ))}
          </div>
        )
      }
    </Container>
  </Section>

  <Section padding="lg" contained={false}>
    <Container>
      <article>
        <div class="flex flex-col gap-12 lg:flex-row lg:gap-14">
          <div class="min-w-0 flex-1">
            <div class:list={[articleBodyClass, 'max-w-[720px] space-y-5 text-ink leading-relaxed']}>
              <Content />
            </div>
            <div class="mt-16 max-w-[720px] border-t border-line pt-10">
              <ArrowLink href="/projects">Back to all projects</ArrowLink>
            </div>
          </div>

          <aside class="lg:w-72 lg:flex-shrink-0 xl:w-80">
            <div class="flex flex-col gap-8 lg:sticky lg:top-24 lg:self-start">
              <AuthorByline label="Built by" />

              <div>
                <p class="font-mono text-xs uppercase tracking-wide text-ink-subtle">Status</p>
                <p class="mt-2 text-sm text-ink-muted">{meta}</p>
              </div>

              {
                links.length > 0 && (
                  <div>
                    <p class="font-mono text-xs uppercase tracking-wide text-ink-subtle">Links</p>
                    <ul class="mt-3 flex flex-col gap-2">
                      {links.map((l) => (
                        <li>
                          <a
                            href={l.href}
                            class="text-sm text-accent no-underline underline-offset-2 hover:underline"
                            target="_blank"
                            rel="noopener"
                          >
                            {l.label} ↗
                          </a>
                        </li>
                      ))}
                    </ul>
                  </div>
                )
              }
            </div>
          </aside>
        </div>

        <RelatedCards title="More projects" items={related} id="related-projects-heading" />
      </article>
    </Container>
  </Section>
</BaseLayout>
