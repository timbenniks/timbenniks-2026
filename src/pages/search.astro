---
import BaseLayout from '../layouts/BaseLayout.astro';
import Section from '../components/primitives/Section.astro';
import SectionHeading from '../components/primitives/SectionHeading.astro';
import { TAG_LABELS } from '../lib/tags';

// Serialize the slug→label map into the page so the client script can use it
// without an extra fetch. Slugs go to Pagefind; labels to the UI.
const tagLabelsJSON = JSON.stringify(TAG_LABELS);
---

<BaseLayout
  title="Search"
  description="Full-text search across writing, videos, and talks. Filter by tag, playlist, year, or content type."
  noindex
>
  <Section padding="lg">
    <SectionHeading
      eyebrow="Find anything"
      title="Search"
      lede="Full-text search across every essay and video. Filter by type, tag, or year."
    />

    <div class="mt-10 max-w-4xl" data-search-root data-tag-labels={tagLabelsJSON}>
      <form
        id="pf-form"
        role="search"
        autocomplete="off"
        class="relative"
        toolname="search_site"
        tooldescription="Full-text search across writing and videos on timbenniks.dev. Use the query field for a topic, title, or name."
      >
        <span class="absolute left-5 top-1/2 -translate-y-1/2 text-ink-subtle" aria-hidden="true">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <circle cx="11" cy="11" r="7"></circle>
            <path d="m20 20-3.5-3.5"></path>
          </svg>
        </span>
        <input
          id="pf-input"
          name="q"
          type="search"
          inputmode="search"
          spellcheck="false"
          placeholder="Search writing and videos…"
          aria-label="Search"
          class="w-full rounded-full border border-line-strong bg-bg-soft py-3.5 pl-13 pr-14 text-base text-ink transition-colors duration-150 focus:border-ink focus:bg-bg focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent"
        />
        <kbd
          id="pf-kbd"
          class="absolute right-4 top-1/2 -translate-y-1/2 hidden rounded-md border border-line bg-bg px-1.5 py-0.5 font-mono text-[11px] text-ink-subtle md:block"
          aria-hidden="true">esc</kbd>
      </form>

      <div id="pf-types" role="group" aria-label="Filter by content type" class="mt-6 inline-flex rounded-full border border-line p-1 text-xs">
        <button type="button" data-type="" data-active="1" aria-pressed="true" class="cursor-pointer rounded-full px-4 py-1.5 font-medium text-ink-muted transition-colors data-[active=1]:bg-ink data-[active=1]:text-bg">All</button>
        <button type="button" data-type="writing" data-active="0" aria-pressed="false" class="cursor-pointer rounded-full px-4 py-1.5 font-medium text-ink-muted transition-colors data-[active=1]:bg-ink data-[active=1]:text-bg">Writing</button>
        <button type="button" data-type="video" data-active="0" aria-pressed="false" class="cursor-pointer rounded-full px-4 py-1.5 font-medium text-ink-muted transition-colors data-[active=1]:bg-ink data-[active=1]:text-bg">Videos</button>
      </div>

      <div class="mt-5 flex flex-wrap items-center gap-2">
        <span class="font-mono text-xs uppercase tracking-wide text-ink-subtle">Tags:</span>
        <div id="pf-tags" class="flex flex-wrap gap-1.5"></div>
        <button
          id="pf-tags-toggle"
          type="button"
          class="hidden cursor-pointer text-xs text-ink-subtle underline underline-offset-2 hover:text-ink"
        >Show all</button>
      </div>

      <div class="mt-5 flex flex-wrap items-center gap-3">
        <label class="font-mono text-xs uppercase tracking-wide text-ink-subtle">
          Year:
          <select
            id="pf-year"
            class="ml-2 rounded-md border border-line-strong bg-bg px-2 py-1 font-sans text-xs text-ink focus:border-ink focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent"
          >
            <option value="">all</option>
          </select>
        </label>
        <button
          id="pf-clear"
          type="button"
          class="hidden cursor-pointer text-xs text-ink-subtle underline underline-offset-2 hover:text-ink"
        >Clear filters</button>
      </div>

      <p id="pf-status" class="mt-8 text-xs uppercase tracking-wide text-ink-subtle" aria-live="polite"></p>

      <ul id="pf-results" class="mt-2 flex flex-col"></ul>

      <div id="pf-empty" hidden class="mt-12 border-t border-line pt-12 text-center">
        <p class="font-serif text-2xl text-ink">No results.</p>
        <p class="mt-2 text-sm text-ink-muted">Try a different query, or clear the filters.</p>
      </div>

      <div id="pf-fallback" hidden class="mt-10 rounded-md border border-line-strong bg-bg-soft p-5 text-sm text-ink-muted">
        Search runs on a build-time index that's only generated by <code class="rounded bg-bg-warm px-1.5 py-0.5 font-mono text-xs text-ink">npm run build</code>.
        In <code class="rounded bg-bg-warm px-1.5 py-0.5 font-mono text-xs text-ink">npm run dev</code> the index isn't available — run <code class="rounded bg-bg-warm px-1.5 py-0.5 font-mono text-xs text-ink">npm run preview</code> to test search.
      </div>

      <noscript>
        <p class="mt-10 text-sm text-ink-muted">
          Search needs JavaScript. Browse <a href="/writing" class="underline">writing</a> or <a href="/videos" class="underline">videos</a> instead.
        </p>
      </noscript>
    </div>
  </Section>
</BaseLayout>

<script>
  import { renderSearchCardHTML, type SearchResult } from '../lib/searchCard';

  type PagefindModule = {
    options: (opts: Record<string, unknown>) => Promise<void>;
    search: (q: string | null, opts?: { filters?: Record<string, unknown> }) => Promise<{
      results: Array<{ id: string; data: () => Promise<SearchResult> }>;
    }>;
    filters: () => Promise<Record<string, Record<string, number>>>;
  };

  type FilterState = { type: string; tags: Set<string>; year: string };

  // Module-level state survives view transitions; DOM refs are re-grabbed each boot.
  let pagefind: PagefindModule | null = null;
  let pagefindLoadFailed = false;
  let allTags: Array<[string, number]> = [];
  let showAllTags = false;
  let tagLabels: Record<string, string> = {};

  function tagDisplay(slug: string): string {
    return tagLabels[slug] ?? slug;
  }

  async function loadPagefind(): Promise<PagefindModule | null> {
    if (pagefind) return pagefind;
    if (pagefindLoadFailed) return null;
    try {
      // @ts-expect-error: dynamic import of an emitted asset path
      const mod = (await import(/* @vite-ignore */ '/pagefind/pagefind.js')) as PagefindModule;
      await mod.options({ excerptLength: 28 });
      pagefind = mod;
      return mod;
    } catch {
      pagefindLoadFailed = true;
      return null;
    }
  }

  function escapeHTML(s: string): string {
    return s.replace(/[&<>"']/g, (c) =>
      ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' })[c]!,
    );
  }

  function renderTags(state: FilterState, tagsEl: HTMLElement, toggleEl: HTMLButtonElement) {
    const visible = showAllTags ? allTags : allTags.slice(0, 20);
    tagsEl.innerHTML = visible
      .map(([tag, count]) => {
        const isActive = state.tags.has(tag);
        const active = isActive ? '1' : '0';
        return `<button type="button" data-tag="${escapeHTML(tag)}" data-active="${active}" aria-pressed="${isActive}" class="cursor-pointer rounded-full border border-line-strong px-2.5 py-1 font-mono text-[11px] tracking-wide text-ink-muted transition-colors hover:border-ink hover:text-ink data-[active=1]:border-ink data-[active=1]:bg-ink data-[active=1]:text-bg"><span>${escapeHTML(tagDisplay(tag))}</span> <span class="text-ink-subtle data-[active=1]:text-bg/70">${count}</span></button>`;
      })
      .join('');
    toggleEl.classList.toggle('hidden', allTags.length <= 20);
    toggleEl.textContent = showAllTags ? 'Show fewer' : `Show all ${allTags.length}`;
  }

  function readURL(state: FilterState, input: HTMLInputElement) {
    const params = new URLSearchParams(location.search);
    input.value = params.get('q') ?? '';
    state.type = params.get('type') ?? '';
    state.year = params.get('year') ?? '';
    state.tags = new Set((params.get('tags') ?? '').split(',').filter(Boolean));
  }

  function syncURL(state: FilterState, input: HTMLInputElement) {
    const params = new URLSearchParams();
    const q = input.value.trim();
    if (q) params.set('q', q);
    if (state.type) params.set('type', state.type);
    if (state.year) params.set('year', state.year);
    if (state.tags.size) params.set('tags', [...state.tags].join(','));
    const qs = params.toString();
    history.replaceState(null, '', qs ? `/search?${qs}` : '/search');
  }

  function buildFilters(state: FilterState): Record<string, unknown> {
    const f: Record<string, unknown> = {};
    if (state.type) f.type = state.type;
    if (state.year) f.year = state.year;
    if (state.tags.size === 1) f.tag = [...state.tags][0];
    else if (state.tags.size > 1) f.tag = { any: [...state.tags] };
    return f;
  }

  function isActive(state: FilterState, q: string): boolean {
    return Boolean(q || state.type || state.year || state.tags.size);
  }

  async function boot() {
    const root = document.querySelector<HTMLElement>('[data-search-root]');
    if (!root) return;

    const labelsRaw = root.dataset.tagLabels;
    if (labelsRaw) {
      try {
        tagLabels = JSON.parse(labelsRaw) as Record<string, string>;
      } catch {
        tagLabels = {};
      }
    }

    const input = document.getElementById('pf-input') as HTMLInputElement;
    const form = document.getElementById('pf-form') as HTMLFormElement;
    const types = document.getElementById('pf-types') as HTMLElement;
    const tagsEl = document.getElementById('pf-tags') as HTMLElement;
    const tagsToggle = document.getElementById('pf-tags-toggle') as HTMLButtonElement;
    const yearSel = document.getElementById('pf-year') as HTMLSelectElement;
    const status = document.getElementById('pf-status') as HTMLElement;
    const results = document.getElementById('pf-results') as HTMLElement;
    const empty = document.getElementById('pf-empty') as HTMLElement;
    const fallback = document.getElementById('pf-fallback') as HTMLElement;
    const clearBtn = document.getElementById('pf-clear') as HTMLButtonElement;

    const state: FilterState = { type: '', tags: new Set(), year: '' };

    function syncTypePills() {
      types.querySelectorAll<HTMLButtonElement>('[data-type]').forEach((b) => {
        const active = b.dataset.type === state.type;
        b.dataset.active = active ? '1' : '0';
        b.setAttribute('aria-pressed', String(active));
      });
    }

    function syncClearBtn() {
      clearBtn.classList.toggle('hidden', !isActive(state, input.value.trim()));
    }

    let debounce: ReturnType<typeof setTimeout> | null = null;
    let runId = 0;

    async function run() {
      syncURL(state, input);
      syncClearBtn();
      const myRun = ++runId;
      const pf = await loadPagefind();
      if (!pf) {
        fallback.hidden = false;
        results.innerHTML = '';
        status.textContent = '';
        empty.hidden = true;
        return;
      }
      fallback.hidden = true;
      const q = input.value.trim();

      if (!isActive(state, q)) {
        results.innerHTML = '';
        empty.hidden = true;
        status.textContent = 'Type a query, pick a tag, or filter by year to start.';
        return;
      }

      status.textContent = 'Searching…';
      // Pagefind: pass null when there's no query so filter-only requests return all matches.
      const queryArg = q.length > 0 ? q : null;
      const search = await pf.search(queryArg, { filters: buildFilters(state) });
      if (myRun !== runId) return; // stale

      const total = search.results.length;
      status.textContent = `${total} ${total === 1 ? 'result' : 'results'}`;

      if (total === 0) {
        results.innerHTML = '';
        empty.hidden = false;
        return;
      }
      empty.hidden = true;

      const top = search.results.slice(0, 30);
      const data = await Promise.all(top.map((r) => r.data()));
      if (myRun !== runId) return; // stale
      results.innerHTML = data.map(renderSearchCardHTML).join('');
    }

    function scheduleRun() {
      if (debounce) clearTimeout(debounce);
      debounce = setTimeout(run, 120);
    }

    // Init filter chrome from Pagefind's known filters once.
    const pf = await loadPagefind();
    if (pf) {
      const filters = await pf.filters();
      allTags = Object.entries(filters.tag ?? {}).sort((a, b) => b[1] - a[1] || a[0].localeCompare(b[0]));
      const years = Object.entries(filters.year ?? {}).sort((a, b) => b[0].localeCompare(a[0]));
      yearSel.innerHTML =
        '<option value="">all</option>' +
        years.map(([y, count]) => `<option value="${escapeHTML(y)}">${escapeHTML(y)} (${count})</option>`).join('');
    } else {
      fallback.hidden = false;
    }

    // Restore state from URL.
    readURL(state, input);
    syncTypePills();
    yearSel.value = state.year;
    renderTags(state, tagsEl, tagsToggle);
    syncClearBtn();

    // Wire events.
    form.addEventListener('submit', (e) => {
      e.preventDefault();
      run();
    });
    input.addEventListener('input', scheduleRun);
    input.addEventListener('keydown', (e) => {
      if (e.key === 'Escape') {
        if (input.value) {
          input.value = '';
          run();
        } else {
          input.blur();
        }
      }
    });

    types.addEventListener('click', (e) => {
      const btn = (e.target as HTMLElement).closest<HTMLButtonElement>('[data-type]');
      if (!btn) return;
      state.type = btn.dataset.type ?? '';
      syncTypePills();
      run();
    });

    tagsEl.addEventListener('click', (e) => {
      const btn = (e.target as HTMLElement).closest<HTMLButtonElement>('[data-tag]');
      if (!btn) return;
      const tag = btn.dataset.tag ?? '';
      if (state.tags.has(tag)) state.tags.delete(tag);
      else state.tags.add(tag);
      renderTags(state, tagsEl, tagsToggle);
      run();
    });

    tagsToggle.addEventListener('click', () => {
      showAllTags = !showAllTags;
      renderTags(state, tagsEl, tagsToggle);
    });

    yearSel.addEventListener('change', () => {
      state.year = yearSel.value;
      run();
    });

    clearBtn.addEventListener('click', () => {
      input.value = '';
      state.type = '';
      state.year = '';
      state.tags.clear();
      yearSel.value = '';
      syncTypePills();
      renderTags(state, tagsEl, tagsToggle);
      run();
      input.focus();
    });

    // Autofocus when arriving without a query and no other state.
    if (!isActive(state, input.value.trim())) input.focus();
    run();
  }

  document.addEventListener('astro:page-load', boot);
</script>

<style is:global>
  /* Pagefind wraps query matches in <mark> within excerpts. */
  .pf-excerpt mark {
    background: transparent;
    color: var(--color-ink);
    font-weight: 600;
    box-shadow: inset 0 -0.4em 0 color-mix(in oklab, var(--color-accent) 20%, transparent);
    padding: 0 0.05em;
  }
</style>
