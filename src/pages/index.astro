---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import HeroSection from '../components/sections/HeroSection.astro';
import QuoteCallout from '../components/sections/QuoteCallout.astro';
import FeatureSplitSection from '../components/sections/FeatureSplitSection.astro';
import CardGridSection from '../components/sections/CardGridSection.astro';
import CardRowsSection from '../components/sections/CardRowsSection.astro';
import ImageTextSection from '../components/sections/ImageTextSection.astro';
import CtaStrip from '../components/sections/CtaStrip.astro';
import { hero, thesis, about, booking } from '../data/site';
import { projects } from '../data/projects';
import { articleToCard, videoToCard, talkToCard, projectToCard } from '../lib/card';
import timPortrait from '../assets/tim.png';
import timOnStage from '../assets/tim_on_stage.png';
import timHero from '../assets/tim-hero.png';

const [writingEntries, videoEntries, speakingEntries] = await Promise.all([
  getCollection('writing', ({ data }) => !data.draft),
  getCollection('videos'),
  getCollection('speaking'),
]);

const sortByDateDesc = <T extends { data: { date: Date } }>(arr: T[]) =>
  arr.sort((a, b) => b.data.date.getTime() - a.data.date.getTime());

const writingItems = sortByDateDesc(writingEntries).slice(0, 3).map((e) => articleToCard(e));
const videoItems = sortByDateDesc(videoEntries).slice(0, 3).map(videoToCard);
const talkItems = sortByDateDesc(speakingEntries).slice(0, 4).map(talkToCard);
const projectItems = projects.map(projectToCard);
---

<BaseLayout
  title="I used to build websites. Now I build what builds them"
  description="Developer Experience Lead at Contentstack. Writing, talks, and videos on developer tools, AI-accelerated engineering, and composable architecture."
  keywords="developer experience, AI-augmented engineering, composable architecture, developer relations, Contentstack, MACH Alliance"
>
  <HeroSection
    headline={{ lead: hero.headlineLead, em: hero.headlineEm, tail: hero.headlineTail }}
    subline={hero.subline}
    ctas={[
      { label: hero.primary.label, href: hero.primary.href, variant: 'primary' },
      { label: hero.secondary.label, href: hero.secondary.href, variant: 'secondary' },
    ]}
    image={{ src: timPortrait, alt: 'Sketched portrait of Tim Benniks', eager: true }}
  />

  <QuoteCallout
    headline={{ lead: thesis.lead, em: thesis.em, tail: thesis.tail }}
    attribution={thesis.attribution}
    cta={thesis.cta}
    tone="dark"
    backgroundImage={{ src: timOnStage }}
  />

  <FeatureSplitSection
    eyebrow="The journal"
    title="Recent writing"
    lede="Essays on developer experience, AI-accelerated engineering, and the platforms that hold it all up."
    items={writingItems}
    cta={{ label: 'All writing', href: '/writing' }}
  />

  <CardGridSection
    eyebrow="The workbench"
    title="What I'm building"
    lede="Platform work, MCP servers, and the occasional weekend experiment. Real code, real trade-offs, work in progress."
    items={projectItems}
    columns={2}
    tone="dark"
    class="mt-16"
    cta={{ label: 'All projects', href: '/projects' }}
  />

  <ImageTextSection
    eyebrow="The short version"
    title="More about Tim"
    lede={about.lead}
    body={about.body}
    image={{ src: timHero, alt: 'Tim Benniks' }}
    cta={{ label: 'Full bio', href: '/about' }}
  />

  <CardGridSection
    eyebrow="On camera"
    title="Videos & livestreams"
    lede="Workshops, demos, and conversations from the YouTube channel and Contentstack streams."
    items={videoItems}
    columns={3}
    cta={{ label: 'All videos', href: '/videos' }}
  />

  <CardRowsSection
    eyebrow="Stages"
    title="Where I've been"
    items={talkItems}
    cta={{ label: 'All talks', href: '/speaking' }}
  />

  <CtaStrip text={booking.text} em={booking.em} cta={booking.cta} />
</BaseLayout>
