---
import { getEntry } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";
import PagePreloadLinks from "../components/PagePreloadLinks.astro";
import PageSections from "../components/PageSections.astro";

const home = await getEntry("pages", "home");
if (!home) {
  throw new Error("Missing content for pages/home");
}

const { metadata, sections } = home.data;
---

<BaseLayout {...metadata}>
  <PagePreloadLinks slot="head" sections={sections} />
  <PageSections sections={sections} />
</BaseLayout>
