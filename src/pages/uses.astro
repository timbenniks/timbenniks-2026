---
import BaseLayout from '../layouts/BaseLayout.astro';
import Section from '../components/primitives/Section.astro';
import SectionHeading from '../components/primitives/SectionHeading.astro';
import Container from '../components/primitives/Container.astro';
import JsonLd from '../components/primitives/JsonLd.astro';
import { breadcrumbSchema, buildGraph } from '../lib/schema';

const graph = buildGraph(
  breadcrumbSchema([
    { name: 'home', url: 'https://timbenniks.dev/' },
    { name: 'uses', url: 'https://timbenniks.dev/uses' },
  ]),
);

type Item = { name: string; note?: string };

const sections: { eyebrow: string; title: string; lede: string; groups: { heading: string; items: Item[] }[] }[] = [
  {
    eyebrow: 'Office',
    title: 'Computer & desk',
    lede: 'A workspace that doubles as a recording studio. Always one button-click from being ready to roll.',
    groups: [
      {
        heading: 'Compute',
        items: [
          { name: '14" MacBook Pro', note: 'M3, 36GB' },
          { name: 'LG UltraFine 32UN500-W', note: '32" 4K' },
          { name: 'CalDigit TS3+ dock' },
          { name: 'Logitech MX Master 3' },
          { name: 'Custom mechanical keyboards', note: 'Tactile, lubed, swapped often' },
        ],
      },
      {
        heading: 'Desk',
        items: [
          { name: 'Yaasa Pro II sit/stand desk' },
          { name: 'Autonomous ErgoChair 2' },
          { name: 'Elgato Stream Deck', note: 'Full size + Mini' },
        ],
      },
    ],
  },
  {
    eyebrow: 'Studio',
    title: 'Audio & video',
    lede: "Built to record talks, livestreams, and YouTube without thinking about gear. Mattresses on the wall — they absorb audio surprisingly well.",
    groups: [
      {
        heading: 'Audio',
        items: [
          { name: 'Rode Rodecaster Pro', note: 'Main interface' },
          { name: 'Rode Streamer X' },
          { name: 'Focusrite Scarlett Solo · 3rd gen' },
          { name: 'Shure SM7b + TritonAudio FetHead' },
          { name: 'Shure NT4', note: 'Stereo for music' },
          { name: 'M-Audio BX5 monitors' },
        ],
      },
      {
        heading: 'Camera',
        items: [
          { name: 'Sony ZV-E10 + Sigma 16mm f/1.4' },
          { name: 'Sony ZV-1', note: 'B-cam, vlogs' },
        ],
      },
      {
        heading: 'Lights',
        items: [
          { name: 'Elgato Key Lights + Flex Arms' },
          { name: 'Godox TL 60 tube lights' },
          { name: 'Aputure Amaran 100D + Godox light dome' },
          { name: 'Aputure Amaran 60D S + 50cm lantern softbox' },
          { name: 'Aputure Amaran P60x' },
        ],
      },
    ],
  },
  {
    eyebrow: 'Software',
    title: 'What runs all day',
    lede: 'A small kit, swapped slowly. The fewer surprises in the editor, the more attention left for the work.',
    groups: [
      {
        heading: 'Editor & terminal',
        items: [
          { name: 'Visual Studio Code', note: 'Night Owl · Material Icon Theme' },
          { name: 'Warp', note: 'with zsh' },
          { name: 'Claude Code', note: 'For the heavy lifting' },
        ],
      },
      {
        heading: 'Browsers',
        items: [
          { name: 'Arc', note: 'Daily driver' },
          { name: 'Chrome', note: 'For DevTools' },
        ],
      },
      {
        heading: 'Design & video',
        items: [
          { name: 'Figma' },
          { name: 'DaVinci Resolve', note: 'YouTube edits' },
          { name: 'OBS', note: 'Livestreaming' },
        ],
      },
    ],
  },
  {
    eyebrow: 'Off the clock',
    title: 'Music',
    lede: "What happens after the laptop closes. Mostly tube amps, mostly old pedals, mostly loud.",
    groups: [
      {
        heading: 'Amps',
        items: [
          { name: 'Marshall JCM-900' },
          { name: 'Fender Blues Deluxe Tweed Reissue' },
        ],
      },
      {
        heading: 'Pedals',
        items: [
          { name: 'Ibanez TS9', note: '1984' },
          { name: 'Maxon TS808' },
          { name: 'Fulltone OCD' },
          { name: 'Fulltone Full Drive' },
          { name: 'Boss DD5 · CE2' },
          { name: 'Cry Baby wah' },
        ],
      },
      {
        heading: 'Guitars',
        items: [
          { name: 'Vintage Fenders, PRS, Gibson' },
          { name: 'Ibanez, Sire, Epiphone' },
          { name: 'Taylor acoustic' },
        ],
      },
    ],
  },
];
---

<BaseLayout
  title="Uses"
  description="The hardware, software, and audio/video kit Tim Benniks uses to build, write, livestream, and ship every day."
  keywords="uses, gear, hardware, software, livestream setup, podcast setup, recording, dev setup"
>
  <JsonLd slot="head" data={graph} />

  <Section padding="lg">
    <div class="max-w-[820px]">
      <p class="font-mono text-xs uppercase tracking-wide text-ink-subtle">/uses</p>
      <h1 class="mt-4 font-serif text-6xl md:text-7xl leading-tight">
        The kit that
        <em class="italic text-accent">does the job</em>
        — and gets out of the way.
      </h1>
      <p class="mt-8 text-xl text-ink-muted">
        A running inventory of the hardware, editor, terminal, and recording gear that gets me
        through a working day. Updated when something actually changes — not when something new
        ships.
      </p>
      <p class="mt-4 font-mono text-xs uppercase tracking-wide text-ink-subtle">
        Last refresh · 2026
      </p>
    </div>
  </Section>

  {sections.map((s, i) => (
    <Section bordered padding="lg" tone={i % 2 === 1 ? 'dark' : 'light'}>
      <div class="grid grid-cols-1 gap-12 md:grid-cols-[1fr_1.4fr]">
        <div class="md:sticky md:top-24 md:self-start">
          <SectionHeading
            eyebrow={s.eyebrow}
            title={s.title}
            lede={s.lede}
            dark={i % 2 === 1}
          />
        </div>

        <div class="flex flex-col gap-10">
          {s.groups.map((g) => (
            <div>
              <p
                class:list={[
                  'font-mono text-xs uppercase tracking-wide',
                  i % 2 === 1 ? 'text-cream-subtle' : 'text-ink-subtle',
                ]}
              >
                {g.heading}
              </p>
              <ul class="mt-3 flex flex-col">
                {g.items.map((item) => (
                  <li
                    class:list={[
                      'grid grid-cols-1 gap-1 border-line py-3 md:grid-cols-[1fr_auto] md:items-baseline md:gap-6 border-b first:border-t',
                      i % 2 === 1 ? 'border-line-dark' : 'border-line',
                    ]}
                  >
                    <span
                      class:list={[
                        'font-serif text-lg leading-snug',
                        i % 2 === 1 ? 'text-cream' : 'text-ink',
                      ]}
                    >
                      {item.name}
                    </span>
                    {item.note && (
                      <span
                        class:list={[
                          'font-mono text-xs uppercase tracking-wide',
                          i % 2 === 1 ? 'text-cream-subtle' : 'text-ink-subtle',
                        ]}
                      >
                        {item.note}
                      </span>
                    )}
                  </li>
                ))}
              </ul>
            </div>
          ))}
        </div>
      </div>
    </Section>
  ))}

  <Container as="section" class="flex flex-wrap items-center justify-between gap-8 pt-16 pb-24">
    <p class="max-w-[600px] font-serif text-2xl">
      The list changes slowly on purpose.
      <em class="italic font-normal text-accent">Stable tools, sharper attention.</em>
    </p>
    <p class="font-mono text-xs uppercase tracking-wide text-ink-subtle">
      Questions? <a href="mailto:hi@timbenniks.dev" class="underline hover:text-ink">hi@timbenniks.dev</a>
    </p>
  </Container>
</BaseLayout>
