---
import { getEntry } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";
import PagePreloadLinks from "../components/PagePreloadLinks.astro";
import PageSections from "../components/PageSections.astro";

const about = await getEntry("pages", "about");
if (!about) {
  throw new Error("Missing content for pages/about");
}

const { metadata, sections } = about.data;
---

<BaseLayout {...metadata}>
  <PagePreloadLinks slot="head" sections={sections} />
  <PageSections sections={sections} />
</BaseLayout>
