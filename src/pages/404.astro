---
import BaseLayout from '../layouts/BaseLayout.astro';
import Section from '../components/primitives/Section.astro';
import Button from '../components/primitives/Button.astro';
---

<BaseLayout title="Not found" description="That page doesn't exist." noindex>
  <Section padding="xl">
    <div class="max-w-[640px]">
      <p class="font-mono text-xs uppercase tracking-widest text-ink-subtle">404</p>
      <h1 class="mt-4 font-serif text-5xl md:text-7xl text-ink">
        That page <em class="italic text-accent">doesn't exist.</em>
      </h1>
      <p class="mt-6 text-lg text-ink-muted">
        Either it never did, or I moved it. For agents: start at
        <a href="/llms.txt" class="underline decoration-accent/40 underline-offset-2">llms.txt</a>,
        <a href="/agents.md" class="underline decoration-accent/40 underline-offset-2">agents.md</a>,
        or the
        <a href="/sitemap.md" class="underline decoration-accent/40 underline-offset-2">markdown sitemap</a>.
        Humans can try home, writing, or search.
      </p>
      <div class="mt-8 flex flex-wrap gap-3">
        <Button href="/" variant="primary">Home</Button>
        <Button href="/llms.txt" variant="secondary">llms.txt</Button>
        <Button href="/writing" variant="secondary">Writing</Button>
        <Button href="/search" variant="secondary">Search</Button>
      </div>
    </div>
  </Section>
</BaseLayout>
