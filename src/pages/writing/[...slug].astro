---
import { getCollection, render, type CollectionEntry } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Section from '../../components/primitives/Section.astro';
import Container from '../../components/primitives/Container.astro';
import Eyebrow from '../../components/primitives/Eyebrow.astro';
import Meta from '../../components/primitives/Meta.astro';
import JsonLd from '../../components/primitives/JsonLd.astro';
import FaqList from '../../components/primitives/FaqList.astro';
import TagPill from '../../components/primitives/TagPill.astro';
import MediaFrame from '../../components/primitives/MediaFrame.astro';
import ArticleSidebar from '../../components/article/ArticleSidebar.astro';
import ArticleTOC from '../../components/article/ArticleTOC.astro';
import RelatedCards from '../../components/RelatedCards.astro';
import { blogPostingSchema, breadcrumbSchema, buildGraph, faqPageSchema } from '../../lib/schema';
import { articleToCard, formatReadingTime } from '../../lib/card';
import { articleBodyClass } from '../../lib/articleBodyClass';
import { relatedArticles } from '../../lib/relatedArticles';
import { tagLabel } from '../../lib/tags';
import { siteUrl } from '../../data/site';

export async function getStaticPaths() {
  const entries = await getCollection('writing', ({ data }) => !data.draft);
  return entries.map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}

interface Props {
  entry: CollectionEntry<'writing'>;
}
const { entry } = Astro.props;
const { Content, headings } = await render(entry);

const formatted = entry.data.date.toLocaleDateString('en-US', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});

const readingLabel = formatReadingTime(entry.data.reading_time);
const description = entry.data.description ?? entry.data.title;
const tocHeadings = headings.filter((h) => h.depth === 2 || h.depth === 3);

const allWriting = await getCollection('writing', ({ data }) => !data.draft);
const related = relatedArticles(entry, allWriting).map((e) => articleToCard(e));

const articleURL = siteUrl(`/writing/${entry.id}`);
const readingMinutes = readingLabel
  ? parseInt(readingLabel, 10) || undefined
  : undefined;
const faqs = entry.data.faqs ?? [];
const canonical = entry.data.canonical_url?.trim() || undefined;

const articleGraph = buildGraph(
  blogPostingSchema({
    url: articleURL,
    title: entry.data.title,
    description,
    image: entry.data.image,
    datePublished: entry.data.date.toISOString(),
    tags: entry.data.tags,
    readingMinutes,
  }),
  breadcrumbSchema([
    { name: 'home', url: siteUrl('/') },
    { name: 'writing', url: siteUrl('/writing') },
    { name: entry.data.title.toLowerCase(), url: articleURL },
  ]),
  ...(faqs.length ? [faqPageSchema(faqs, { url: articleURL })] : []),
);
---

<BaseLayout
  title={entry.data.title}
  description={description}
  image={entry.data.image}
  imageAlt={entry.data.title}
  type="article"
  publishedTime={entry.data.date}
  tags={entry.data.tags}
  keywords={entry.data.tags.join(', ')}
  canonical={canonical}
>
  <JsonLd slot="head" data={articleGraph} />
  <link
    slot="head"
    rel="alternate"
    type="text/markdown"
    href={`/writing/${entry.id}.md`}
    title="Markdown source"
  />
  <Section padding="lg" contained={false}>
    <Container>
      <article
        data-pagefind-body
        data-pagefind-meta={`title:${entry.data.title}, date:${entry.data.date.toISOString().slice(0, 10)}, image:${entry.data.image ?? ''}`}
      >
        <span hidden data-pagefind-filter="type:writing">writing</span>
        <span hidden data-pagefind-filter={`year:${entry.data.date.getUTCFullYear()}`}>{entry.data.date.getUTCFullYear()}</span>
        {entry.data.tags.map((tag: string) => (
          <span hidden data-pagefind-filter={`tag:${tag}`}>{tag}</span>
        ))}

        <header class="border-b border-line pb-10">
          <Eyebrow>
            <a href="/writing" class="hover:underline">← All writing</a>
          </Eyebrow>
          <h1 class="mt-3 max-w-[820px] font-serif text-5xl leading-tight text-ink md:text-6xl">
            {entry.data.title}
          </h1>
          <div class="mt-6 flex flex-wrap items-center gap-4">
            <Meta items={[formatted]} />
            {
              entry.data.tags.length > 0 && (
                <div class="flex flex-wrap gap-2">
                  {entry.data.tags.map((tag: string) => (
                    <TagPill href={`/writing/tag/${tag}`} size="sm">
                      {tagLabel(tag)}
                    </TagPill>
                  ))}
                </div>
              )
            }
          </div>
        </header>

        <div class="mt-10 flex flex-col gap-12 lg:flex-row lg:gap-14">
          <div class="min-w-0 flex-1">
            {
              entry.data.image && (
                <MediaFrame aspect="video" class="mb-10 lg:hidden">
                  <img
                    src={entry.data.image}
                    alt={entry.data.title}
                    width="768"
                    height="432"
                    class="h-full w-full object-cover"
                    loading="eager"
                    fetchpriority="high"
                  />
                </MediaFrame>
              )
            }

            <div class:list={[articleBodyClass, 'max-w-[720px] space-y-5 text-ink leading-relaxed']}>
              <Content />
            </div>

            {
              tocHeadings.length > 0 && (
                <details class="mt-12 max-w-[720px] border border-line lg:hidden">
                  <summary class="cursor-pointer px-4 py-3 font-mono text-xs uppercase tracking-wide text-ink-muted">
                    On this page
                  </summary>
                  <div class="border-t border-line px-4 py-4">
                    <ArticleTOC headings={headings} showLabel={false} />
                  </div>
                </details>
              )
            }

            {
              faqs.length > 0 && (
                <aside class="mt-16 max-w-[720px] border-t border-line pt-10">
                  <h2 class="mb-6 font-serif text-3xl font-medium text-ink">
                    Frequently asked questions
                  </h2>
                  <FaqList items={faqs} emitJsonLd={false} />
                </aside>
              )
            }
          </div>

          <ArticleSidebar
            title={entry.data.title}
            image={entry.data.image}
            readingLabel={readingLabel}
            headings={headings}
          />
        </div>

        <RelatedCards title="Related articles" items={related} id="related-articles-heading" />
      </article>
    </Container>
  </Section>
</BaseLayout>
