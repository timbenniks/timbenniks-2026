---
import { getCollection, type CollectionEntry } from 'astro:content';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Section from '../../../components/primitives/Section.astro';
import Eyebrow from '../../../components/primitives/Eyebrow.astro';
import JsonLd from '../../../components/primitives/JsonLd.astro';
import Card from '../../../components/Card.astro';
import { articleToCard } from '../../../lib/card';
import { breadcrumbSchema, buildGraph } from '../../../lib/schema';
import { tagLabel } from '../../../lib/tags';
import { siteUrl } from '../../../data/site';

export async function getStaticPaths() {
  const entries = await getCollection('writing', ({ data }) => !data.draft);
  const tagMap = new Map<string, CollectionEntry<'writing'>[]>();

  for (const entry of entries) {
    for (const tag of entry.data.tags) {
      if (!tagMap.has(tag)) tagMap.set(tag, []);
      tagMap.get(tag)!.push(entry);
    }
  }

  return [...tagMap.entries()].map(([slug, posts]) => ({
    params: { tag: slug },
    props: {
      tag: slug,
      posts: posts.sort((a, b) => b.data.date.getTime() - a.data.date.getTime()),
    },
  }));
}

interface Props {
  tag: string;
  posts: CollectionEntry<'writing'>[];
}
const { tag, posts } = Astro.props;
const label = tagLabel(tag);

const items = posts.map((p) => articleToCard(p));

const graph = buildGraph(
  breadcrumbSchema([
    { name: 'home', url: siteUrl('/') },
    { name: 'writing', url: siteUrl('/writing') },
    { name: label, url: siteUrl(`/writing/tag/${tag}`) },
  ]),
);
---

<BaseLayout
  title={`${label} — Writing`}
  description={`Essays tagged "${label}" on developer experience, AI engineering, and composable platforms.`}
  keywords={label}
>
  <JsonLd slot="head" data={graph} />

  <Section padding="lg">
    <Eyebrow>{`Tag · ${posts.length} ${posts.length === 1 ? 'essay' : 'essays'}`}</Eyebrow>
    <h1 class="font-serif font-medium text-5xl text-ink mb-4">{label}</h1>
    <p class="max-w-[560px] text-base text-ink-muted">{`Writing tagged "${label}".`}</p>

    <div class="mt-6">
      <a href="/writing" class="text-xs uppercase tracking-wide text-ink-subtle hover:text-ink">
        ← All writing
      </a>
    </div>

    <div class="mt-8 flex flex-col">
      {items.map((item) => <Card item={item} format="row" />)}
    </div>
  </Section>
</BaseLayout>
