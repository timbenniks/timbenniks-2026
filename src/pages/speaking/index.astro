---
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Section from '../../components/primitives/Section.astro';
import Container from '../../components/primitives/Container.astro';
import Card from '../../components/Card.astro';
import JsonLd from '../../components/primitives/JsonLd.astro';
import Button from '../../components/primitives/Button.astro';
import { talkToCard } from '../../lib/card';
import { breadcrumbSchema, buildGraph } from '../../lib/schema';
import { yearsActive } from '../../lib/stats';
import { siteUrl } from '../../data/site';
import { fullBleedWidths } from '../../lib/image-widths';

const graph = buildGraph(
  breadcrumbSchema([
    { name: 'home', url: siteUrl('/') },
    { name: 'speaking', url: siteUrl('/speaking') },
  ]),
);

const entries = (await getCollection('speaking')).sort(
  (a, b) => b.data.date.getTime() - a.data.date.getTime(),
);

const conferences = new Set(entries.map((e) => e.data.conference));
const locations = new Set(
  entries.map((e) => e.data.location).filter((l): l is string => Boolean(l)),
);
const years = yearsActive(entries);

const cutoff = new Date();
cutoff.setHours(0, 0, 0, 0);
const upcoming = entries.filter((e) => e.data.date >= cutoff);
const past = entries.filter((e) => e.data.date < cutoff);

const upcomingItems = upcoming.map(talkToCard);
const pastItems = past.map(talkToCard);
---

<BaseLayout
  title="Speaking"
  description="Conference talks, workshops, and podcast appearances on developer experience, AI agents, and composable architecture."
  image="https://res.cloudinary.com/dwfcofnrd/image/upload/q_auto,f_auto,w_1280/Tim/Tim%20On%20Stage.jpg"
  keywords="speaker, keynote, conference, workshop, podcast, developer experience, AI agents"
>
  <JsonLd slot="head" data={graph} />

  <Section tone="dark" padding="xl" class="relative isolate overflow-hidden">
    <Image
      src="https://res.cloudinary.com/dwfcofnrd/image/upload/v1743504260/website/tim_on_stage-1.png"
      widths={fullBleedWidths}
      sizes="100vw"
      width={2355}
      height={1011}
      alt=""
      aria-hidden="true"
      loading="lazy"
      decoding="async"
      class="object-cover absolute inset-0 -z-10 h-full w-full opacity-25"
    />

    <div class="max-w-[800px]">
      <p class="font-mono text-xs uppercase tracking-wide text-cream-subtle">Stages</p>
      <h1 class="mt-4 font-serif text-6xl md:text-7xl leading-tight">
        Six years on stage.
        <em class="italic text-accent">Still showing up.</em>
      </h1>
      <p class="mt-8 text-xl text-cream-muted max-w-[680px]">
        Keynotes, technical deep-dives, panels, and podcasts on developer experience, AI-augmented
        engineering, and composable architecture. Available for events worldwide.
      </p>
      <div class="mt-8">
        <Button href="/press-kit" variant="accent">Press kit & booking</Button>
      </div>
    </div>

    <dl class="mt-16 grid grid-cols-2 gap-6 max-w-[700px] md:grid-cols-4">
      <div>
        <dt class="font-mono text-xs uppercase tracking-wide text-cream-subtle">Talks</dt>
        <dd class="mt-1 font-serif text-4xl text-cream tabular-nums">{entries.length}</dd>
      </div>
      <div>
        <dt class="font-mono text-xs uppercase tracking-wide text-cream-subtle">Conferences</dt>
        <dd class="mt-1 font-serif text-4xl text-cream tabular-nums">{conferences.size}</dd>
      </div>
      <div>
        <dt class="font-mono text-xs uppercase tracking-wide text-cream-subtle">Cities</dt>
        <dd class="mt-1 font-serif text-4xl text-cream tabular-nums">{locations.size}</dd>
      </div>
      <div>
        <dt class="font-mono text-xs uppercase tracking-wide text-cream-subtle">Years</dt>
        <dd class="mt-1 font-serif text-4xl text-cream tabular-nums">{years}</dd>
      </div>
    </dl>
  </Section>

  {upcomingItems.length > 0 && (
    <Section bordered padding="lg">
      <Container padded={false}>
        <p class="font-mono text-xs uppercase tracking-wide text-accent">Upcoming</p>
        <h2 class="mt-3 font-serif text-4xl text-ink">Where I'll be next</h2>
      </Container>

      <div class="mt-10 flex flex-col">
        {upcomingItems.map((item, i) => (
          <Card item={item} format="row" isLast={i === upcomingItems.length - 1} />
        ))}
      </div>
    </Section>
  )}

  <Section bordered padding="lg">
    <Container padded={false}>
      <p class="font-mono text-xs uppercase tracking-wide text-ink-subtle">The archive</p>
      <h2 class="mt-3 font-serif text-4xl text-ink">All past talks</h2>
      <p class="mt-3 max-w-[600px] text-base text-ink-muted">
        {past.length} talks across {conferences.size} conferences, {years} years. The newest at the top.
      </p>
    </Container>

    <div class="mt-10 flex flex-col">
      {pastItems.map((item) => <Card item={item} format="row" />)}
    </div>
  </Section>
</BaseLayout>
