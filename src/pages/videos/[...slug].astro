---
import { getCollection, render, type CollectionEntry } from 'astro:content';
import { getImage } from 'astro:assets';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Section from '../../components/primitives/Section.astro';
import Container from '../../components/primitives/Container.astro';
import Eyebrow from '../../components/primitives/Eyebrow.astro';
import Meta from '../../components/primitives/Meta.astro';
import JsonLd from '../../components/primitives/JsonLd.astro';
import TagPill from '../../components/primitives/TagPill.astro';
import YoutubeEmbed from '../../components/primitives/YoutubeEmbed.astro';
import AuthorByline from '../../components/primitives/AuthorByline.astro';
import Button from '../../components/primitives/Button.astro';
import RelatedCards from '../../components/RelatedCards.astro';
import { breadcrumbSchema, buildGraph, videoObjectSchema } from '../../lib/schema';
import { videoToCard } from '../../lib/card';
import { articleBodyClass } from '../../lib/articleBodyClass';
import { relatedVideos } from '../../lib/relatedVideos';
import { playlistHref, playlistLabel } from '../../lib/playlists';
import { tagLabel } from '../../lib/tags';
import { siteUrl } from '../../data/site';
import { resolveYoutubeThumbnail } from '../../lib/youtube-thumbnail';

export async function getStaticPaths() {
  const entries = await getCollection('videos');
  return entries.map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}

interface Props {
  entry: CollectionEntry<'videos'>;
}
const { entry } = Astro.props;
const { Content } = await render(entry);

const formatted = entry.data.date.toLocaleDateString('en-US', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});

const tags = entry.data.tags ?? [];
const description = entry.data.description ?? entry.data.title;
const descriptionParagraphs = entry.data.description?.trim().split(/\n{2,}/) ?? [];
const youtubeUrl = `https://www.youtube.com/watch?v=${entry.data.videoId}`;
const playlistUrl = playlistHref(entry.data.playlist);
const playlistName = playlistLabel(entry.data.playlist);

const { url: ytPosterSrc } = await resolveYoutubeThumbnail(entry.data.videoId);
const ytThumbImg = await getImage({
  src: ytPosterSrc,
  width: 1280,
  height: 720,
  alt: entry.data.title,
});
const ytThumb = ytThumbImg.src;

const allVideos = await getCollection('videos');
const related = await Promise.all(relatedVideos(entry, allVideos).map(videoToCard));

const videoURL = siteUrl(`/videos/${entry.id}`);
const videoGraph = buildGraph(
  videoObjectSchema({
    url: videoURL,
    title: entry.data.title,
    description,
    datePublished: entry.data.date.toISOString(),
    thumbnailUrl: ytThumb,
    videoId: entry.data.videoId,
    transcript: entry.data.transcript,
    tags,
  }),
  breadcrumbSchema([
    { name: 'home', url: siteUrl('/') },
    { name: 'videos', url: siteUrl('/videos') },
    { name: entry.data.title.toLowerCase(), url: videoURL },
  ]),
);
---

<BaseLayout
  title={entry.data.title}
  description={description}
  image={ytThumb}
  imageAlt={entry.data.title}
  type="article"
  publishedTime={entry.data.date}
  tags={tags}
  keywords={tags.join(', ')}
>
  <JsonLd slot="head" data={videoGraph} />
  <Section padding="lg" contained={false}>
    <Container>
      <article
        data-pagefind-body
        data-pagefind-meta="title[data-title], date[data-date], image[data-image]"
        data-title={entry.data.title}
        data-date={entry.data.date.toISOString().slice(0, 10)}
        data-image={ytThumb ?? ''}
      >
        <span hidden data-pagefind-filter="type:video">video</span>
        <span hidden data-pagefind-filter={`playlist:${entry.data.playlist}`}>{entry.data.playlist}</span>
        <span hidden data-pagefind-filter={`year:${entry.data.date.getUTCFullYear()}`}>{entry.data.date.getUTCFullYear()}</span>
        {tags.map((tag: string) => (
          <span hidden data-pagefind-filter={`tag:${tag}`}>{tag}</span>
        ))}

        <header class="border-b border-line pb-10">
          <Eyebrow>
            <a href="/videos" class="hover:underline">← All videos</a>
          </Eyebrow>
          <h1 class="mt-3 max-w-[900px] font-serif text-4xl leading-tight text-ink md:text-5xl">
            {entry.data.title}
          </h1>
          <div class="mt-6 flex flex-wrap items-center gap-4">
            <Meta items={[formatted, entry.data.duration].filter(Boolean) as string[]} />
            <div class="flex flex-wrap gap-2">
              <TagPill href={playlistUrl} size="sm" tone="accent">
                {playlistName}
              </TagPill>
              {tags.map((tag: string) => (
                <TagPill size="sm">{tagLabel(tag)}</TagPill>
              ))}
            </div>
          </div>
        </header>

        {
          entry.data.videoId && (
            <YoutubeEmbed
              class="mt-10"
              videoId={entry.data.videoId}
              title={entry.data.title}
              poster={ytThumb}
            />
          )
        }

        <div class="mt-12 flex flex-col gap-12 lg:flex-row lg:gap-14">
          <div class="min-w-0 flex-1">
            <div class:list={[articleBodyClass, 'max-w-[720px] space-y-5 text-ink leading-relaxed']}>
              {descriptionParagraphs.map((paragraph) => <p>{paragraph}</p>)}
              <Content />
            </div>

            {
              entry.data.transcript && (
                <details class="mt-12 max-w-[720px] border border-line">
                  <summary class="cursor-pointer px-4 py-3 font-mono text-xs uppercase tracking-wide text-ink-muted hover:text-ink">
                    Transcript
                  </summary>
                  <div class="max-h-[28rem] overflow-y-auto border-t border-line px-4 py-5">
                    <p class="whitespace-pre-wrap text-sm leading-relaxed text-ink-muted">
                      {entry.data.transcript}
                    </p>
                  </div>
                </details>
              )
            }
          </div>

          <aside class="lg:w-72 lg:flex-shrink-0 xl:w-80" data-pagefind-ignore>
            <div class="flex flex-col gap-8 lg:sticky lg:top-24 lg:self-start">
              <AuthorByline label="Presented by" />

              {
                entry.data.duration && (
                  <p class="font-mono text-xs uppercase tracking-wide text-accent">
                    {entry.data.duration}
                  </p>
                )
              }

              <div class="flex flex-col gap-3">
                <Button href={youtubeUrl} variant="accent" size="sm" target="_blank" rel="noopener">
                  Watch on YouTube ↗
                </Button>
                <Button href={playlistUrl} variant="secondary" size="sm">
                  More in {playlistName}
                </Button>
              </div>
            </div>
          </aside>
        </div>

        <RelatedCards title="Related videos" items={related} id="related-videos-heading" />
      </article>
    </Container>
  </Section>
</BaseLayout>
