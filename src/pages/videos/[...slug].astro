---
import { getCollection, render, type CollectionEntry } from 'astro:content';
import { getImage } from 'astro:assets';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Section from '../../components/primitives/Section.astro';
import Container from '../../components/primitives/Container.astro';
import Eyebrow from '../../components/primitives/Eyebrow.astro';
import Meta from '../../components/primitives/Meta.astro';
import JsonLd from '../../components/primitives/JsonLd.astro';
import { breadcrumbSchema, buildGraph, videoObjectSchema } from '../../lib/schema';
import { siteUrl } from '../../data/site';
import { resolveYoutubeThumbnail } from '../../lib/youtube-thumbnail';

export async function getStaticPaths() {
  const entries = await getCollection('videos');
  return entries.map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}

interface Props {
  entry: CollectionEntry<'videos'>;
}
const { entry } = Astro.props;
const { Content } = await render(entry);

const formatted = entry.data.date.toLocaleDateString('en-US', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});

const metaItems = [
  entry.data.playlist,
  formatted,
  entry.data.duration ?? '',
].filter(Boolean) as string[];

const description = entry.data.description ?? entry.data.title;
// Probe maxresdefault availability, then route the YouTube poster through
// astro:assets so it gets Cloudinary's f_auto,q_auto,w_<n> pipeline.
const { url: ytPosterSrc } = await resolveYoutubeThumbnail(entry.data.videoId);
const [ytThumbImg, litePosterImg] = await Promise.all([
  getImage({ src: ytPosterSrc, width: 1280, height: 720, alt: entry.data.title }),
  getImage({ src: ytPosterSrc, width: 720, height: 405, alt: entry.data.title }),
]);
const ytThumb = ytThumbImg.src;
const litePoster = litePosterImg.src;

const videoURL = siteUrl(`/videos/${entry.id}`);
const videoGraph = buildGraph(
  videoObjectSchema({
    url: videoURL,
    title: entry.data.title,
    description,
    datePublished: entry.data.date.toISOString(),
    thumbnailUrl: ytThumb,
    videoId: entry.data.videoId,
    transcript: entry.data.transcript,
    tags: entry.data.tags,
  }),
  breadcrumbSchema([
    { name: 'home', url: siteUrl('/') },
    { name: 'videos', url: siteUrl('/videos') },
    { name: entry.data.title.toLowerCase(), url: videoURL },
  ]),
);
---

<BaseLayout
  title={entry.data.title}
  description={description}
  image={ytThumb}
  imageAlt={entry.data.title}
  type="article"
  publishedTime={entry.data.date}
  tags={entry.data.tags}
  keywords={entry.data.tags?.join(', ')}
>
  <JsonLd slot="head" data={videoGraph} />
  <link
    slot="head"
    rel="alternate"
    type="text/markdown"
    href={`/videos/${entry.id}.md`}
    title="Markdown source"
  />
  <Section padding="lg" contained={false}>
    <Container>
      <article
        data-pagefind-body
        data-pagefind-meta={`title:${entry.data.title}, date:${entry.data.date.toISOString().slice(0, 10)}, image:${ytThumb ?? ''}`}
      >
        <span hidden data-pagefind-filter="type:video">video</span>
        <span hidden data-pagefind-filter={`playlist:${entry.data.playlist}`}>{entry.data.playlist}</span>
        <span hidden data-pagefind-filter={`year:${entry.data.date.getUTCFullYear()}`}>{entry.data.date.getUTCFullYear()}</span>
        {entry.data.tags?.map((tag: string) => (
          <span hidden data-pagefind-filter={`tag:${tag}`}></span>
        ))}
        <header class="max-w-[820px] mb-10">
          <Eyebrow>
            <a href="/videos" class="hover:underline">← All videos</a>
          </Eyebrow>
          <h1 class="font-serif text-4xl md:text-5xl leading-tight text-ink mt-3">
            {entry.data.title}
          </h1>
          <div class="mt-5">
            <Meta items={metaItems} />
          </div>
        </header>

        {entry.data.videoId && (
          <div class="aspect-video overflow-hidden border border-line bg-bg-dark">
            <lite-youtube
              videoid={entry.data.videoId}
              videotitle={entry.data.title}
              style={`background-image: url('${litePoster}');`}
            ></lite-youtube>
          </div>
        )}

        {entry.data.description && (
          <p class="mt-8 max-w-[720px] font-serif text-xl leading-snug text-ink">
            {entry.data.description}
          </p>
        )}

        <div class="article-body mt-10 max-w-[720px] space-y-5 text-ink leading-relaxed">
          <Content />
        </div>
      </article>
    </Container>
  </Section>
</BaseLayout>

<script>
  import 'lite-youtube-embed';
  import 'lite-youtube-embed/src/lite-yt-embed.css';
</script>
